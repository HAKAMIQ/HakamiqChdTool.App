<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>HakamiqChdTool</AssemblyName>
		<RootNamespace>HakamiqChdTool.App</RootNamespace>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<LangVersion>14.0</LangVersion>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest</AnalysisLevel>
		<ImplicitUsings>enable</ImplicitUsings>
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditMode>all</NuGetAuditMode>
		<NuGetAuditLevel>low</NuGetAuditLevel>
		<WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);artifacts\**</DefaultItemExcludesInProjectFolder>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\HakamiqLogo.ico</ApplicationIcon>
		<Version>1.4.0</Version>
		<AssemblyVersion>1.4.0.0</AssemblyVersion>
		<FileVersion>1.4.0.0</FileVersion>
		<InformationalVersion>v1.4.0</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Product>CHD Tool</Product>
		<Company>Hakamiq</Company>
		<Description>إدارة وتحويل صور الأقراص بصيغة CHD عبر chdman</Description>
		<PackageIcon>HakamiqLogo.png</PackageIcon>
		<NeutralLanguage>ar-SA</NeutralLanguage>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<UseAppHost>true</UseAppHost>
		<SatelliteResourceLanguages>ar-SA</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="HakamiqChdTool.App.Tests\**" />
		<EmbeddedResource Remove="HakamiqChdTool.App.Tests\**" />
		<None Remove="HakamiqChdTool.App.Tests\**" />
		<Page Remove="HakamiqChdTool.App.Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="Views\Options\PathsView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Views\Options\RedumpView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Views\Options\ProcView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Views\Options\PerfView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Compile Update="Views\Options\PathsView.xaml.cs">
			<DependentUpon>PathsView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="Views\Options\RedumpView.xaml.cs">
			<DependentUpon>RedumpView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="Views\Options\ProcView.xaml.cs">
			<DependentUpon>ProcView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="Views\Options\PerfView.xaml.cs">
			<DependentUpon>PerfView.xaml</DependentUpon>
			<SubType>Code</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Tools\chdman.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>


		<Resource Include="Resources\HakamiqLogo.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Resources\HakamiqLogo.ico">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>

		<None Include="Resources\HakamiqLogo.png" Pack="true" PackagePath="\" Visible="false" />

		<Content Include="README.md">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="LICENSE">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\LEGAL.md">
			<TargetPath>LEGAL.md</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\3P_NOTICE.txt">
			<TargetPath>3P_NOTICE.txt</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\CHDMAN_NOTICE.md">
			<TargetPath>CHDMAN_NOTICE.md</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\7ZIP.md">
			<TargetPath>docs\legal\7ZIP.md</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<Content Include="docs\legal\CSOKIT_NOTICE.md">
			<TargetPath>CSOKIT_NOTICE.md</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<Content Include="docs\sbom.cdx.json">
			<TargetPath>docs\sbom.cdx.json</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="docs\release-notes\CHANGELOG.md">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\MAME_COPYING.txt">
			<TargetPath>MAME_COPYING.txt</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="docs\legal\MAME_GPL-2.0.txt">
			<TargetPath>MAME_GPL-2.0.txt</TargetPath>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\7zip\7z.exe" Condition="Exists('Tools\7zip\7z.exe')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\7zip\7z.dll" Condition="Exists('Tools\7zip\7z.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\7zip\License.txt" Condition="Exists('Tools\7zip\License.txt')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\csokit.exe" Condition="Exists('Tools\hakamiq-cso\win-x64\csokit.exe')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\CsoKit.Native.dll" Condition="Exists('Tools\hakamiq-cso\win-x64\CsoKit.Native.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\LICENSE.txt" Condition="Exists('Tools\hakamiq-cso\win-x64\LICENSE.txt')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\README.md" Condition="Exists('Tools\hakamiq-cso\win-x64\README.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\RELEASE_NOTES.md" Condition="Exists('Tools\hakamiq-cso\win-x64\RELEASE_NOTES.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\SHA256SUMS.txt" Condition="Exists('Tools\hakamiq-cso\win-x64\SHA256SUMS.txt')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<Content Include="Tools\hakamiq-cso\win-x64\THIRD_PARTY_NOTICES.md" Condition="Exists('Tools\hakamiq-cso\win-x64\THIRD_PARTY_NOTICES.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="Humanizer.Core" Version="3.0.10" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="SharpCompress" Version="0.50.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
		<PackageReference Include="LTRData.DiscUtils.Iso9660" Version="1.0.87" />
		<PackageReference Include="LTRData.DiscUtils.Udf" Version="1.0.87" />
		<PackageReference Include="System.Management" Version="10.0.10" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
	</ItemGroup>


</Project>
