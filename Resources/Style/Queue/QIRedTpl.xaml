<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/Queue/QItemBase.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/Queue/QWShared.xaml" />
</ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="QueueItemRedumpFieldsTemplate">
        <Border Margin="{DynamicResource Inset.0.8.0.0}"
                ToolTip="{DynamicResource LocQueue_RedumpValidatingTooltip}">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource FluentQueueInlineSurfaceBorder}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Padding" Value="{DynamicResource Inset.10.6}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                    <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
                    <Setter Property="CornerRadius" Value="{DynamicResource Radius.QueueSurface}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="UseLayoutRounding" Value="True" />

                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsRedumpOperationActive}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsRedumpFeatureVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                  Language="{DynamicResource App.XmlLanguage}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          VerticalAlignment="Center"
                          FlowDirection="{DynamicResource App.FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="{DynamicResource Space.14}"
                                 Height="{DynamicResource Space.14}"
                                 VerticalAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform"
                                 SnapsToDevicePixels="True">
                            <Path Data="{StaticResource Icon.DatabaseSearch}"
                                  Fill="{DynamicResource Brush.Accent}"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                        </Viewbox>

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FontWeight="{DynamicResource FontWeight.SemiBold}"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="{DynamicResource LocQueue_RedumpValidatingTitle}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="2"
                          MinWidth="{DynamicResource Space.48}"
                          VerticalAlignment="Center"
                          FlowDirection="LeftToRight">
                        <Border Style="{StaticResource FluentQueueMetaPillBorder}"
                                Visibility="{Binding ShowRedumpProgressPercent, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FluentQueueMetaPillText}"
                                       HorizontalAlignment="Center"
                                       FlowDirection="LeftToRight"
                                       Language="en-US"
                                       TextAlignment="Center"
                                       Text="{Binding RedumpProgressPercentDisplay, Converter={StaticResource BidiTextConverter}, ConverterParameter=Technical}" />
                        </Border>

                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource FluentQueueActivityDotsText}"
                                   Visibility="{Binding RedumpIsIndeterminate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="{DynamicResource Inset.0.6.0.0}"
                           Style="{StaticResource FluentQueueDetailText}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="{Binding RedumpProgressStatusDisplay}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <ProgressBar Grid.Row="2"
                             Margin="{DynamicResource Inset.0.8.0.0}"
                             FlowDirection="LeftToRight"
                             Minimum="{DynamicResource Progress.Minimum}"
                             Maximum="{DynamicResource Progress.Maximum}"
                             IsIndeterminate="{Binding RedumpIsIndeterminate}"
                             Value="{Binding RedumpProgressValue, Mode=OneWay}"
                             Style="{StaticResource FluentQueueCardProgressBar}" />

                <Grid Grid.Row="3"
                      Margin="{DynamicResource Inset.0.6.0.0}"
                      FlowDirection="LeftToRight"
                      Visibility="{Binding HasRedumpMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FlowDirection="LeftToRight"
                               Language="en-US"
                               TextAlignment="Left"
                               FontFamily="{DynamicResource FontFamily.Mono}"
                               FontSize="{DynamicResource FontSize.CaptionSmall}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Text="{Binding RedumpBytesDisplay}"
                               Visibility="{Binding HasRedumpByteProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight">
                        <TextBlock FlowDirection="LeftToRight"
                                   Language="en-US"
                                   TextAlignment="Left"
                                   FontFamily="{DynamicResource FontFamily.Mono}"
                                   FontSize="{DynamicResource FontSize.CaptionSmall}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="{Binding RedumpSpeedDisplay}"
                                   Visibility="{Binding HasRedumpSpeed, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Margin="{DynamicResource Inset.8.0.0.0}"
                                   FlowDirection="LeftToRight"
                                   Language="en-US"
                                   TextAlignment="Left"
                                   FontFamily="{DynamicResource FontFamily.Mono}"
                                   FontSize="{DynamicResource FontSize.CaptionSmall}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="{Binding RedumpEtaDisplay}"
                                   Visibility="{Binding HasRedumpEta, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
