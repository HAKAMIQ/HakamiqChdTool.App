<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/Queue/QItemBase.xaml" />
        <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/Queue/QWShared.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ToolTip x:Key="AppTip.QIActionsTpl.1"
             x:Shared="False"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             Content="{DynamicResource LocCtx_OpenPath}">
        <ToolTip.ContentTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                           MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontFamily="{DynamicResource FontFamily.Base}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           FlowDirection="{DynamicResource App.FlowDirection}"
                           Language="{DynamicResource App.XmlLanguage}"
                           TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
            </DataTemplate>
        </ToolTip.ContentTemplate>
    </ToolTip>

    <ToolTip x:Key="AppTip.QIActionsTpl.2"
             x:Shared="False"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             Content="{DynamicResource LocCtx_CancelJob}">
        <ToolTip.ContentTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                           MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontFamily="{DynamicResource FontFamily.Base}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           FlowDirection="{DynamicResource App.FlowDirection}"
                           Language="{DynamicResource App.XmlLanguage}"
                           TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
            </DataTemplate>
        </ToolTip.ContentTemplate>
    </ToolTip>

    <ToolTip x:Key="AppTip.QIActionsTpl.3"
             x:Shared="False"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             Content="{DynamicResource LocQueue_VerificationResultTooltip}">
        <ToolTip.ContentTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                           MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontFamily="{DynamicResource FontFamily.Base}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           FlowDirection="{DynamicResource App.FlowDirection}"
                           Language="{DynamicResource App.XmlLanguage}"
                           TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
            </DataTemplate>
        </ToolTip.ContentTemplate>
    </ToolTip>

    <ToolTip x:Key="AppTip.QIActionsTpl.4"
             x:Shared="False"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             Content="{DynamicResource LocCtx_Retry}">
        <ToolTip.ContentTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                           MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontFamily="{DynamicResource FontFamily.Base}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           FlowDirection="{DynamicResource App.FlowDirection}"
                           Language="{DynamicResource App.XmlLanguage}"
                           TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
            </DataTemplate>
        </ToolTip.ContentTemplate>
    </ToolTip>

    <DataTemplate x:Key="QueueItemActionsFieldsTemplate">
        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="{DynamicResource Inset.0.4.0.0}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UiShowRunningActionsRow}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsProgressActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding HasRuntimeProgressDetail}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding UiShowTerminalActionsRow}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.4}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          MinWidth="0"
                          ClipToBounds="True"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="{DynamicResource Inset.None}"
                              ClipToBounds="True"
                              FlowDirection="{DynamicResource App.FlowDirection}"
                              Language="{DynamicResource App.XmlLanguage}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Height="20"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FluentQueueCollapsibleDetailText}"
                                       Text="{Binding QueueRowDisplayDetailArabic, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                                       TextAlignment="Left"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       TextOptions.TextFormattingMode="Display"
                                       Typography.NumeralAlignment="Tabular"
                                       Typography.NumeralStyle="Lining"
                                       NumberSubstitution.Substitution="European"
                                       ToolTip="{Binding QueueRowExtendedTooltip}"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True" />

                            <TextBlock Grid.Column="2"
                                       Width="{DynamicResource Space.0}"
                                       Visibility="Collapsed"
                                       Style="{StaticResource FluentQueueActivityDotsText}"
                                       ToolTip="{Binding QueueRowExtendedTooltip}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2"
                          VerticalAlignment="Center"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource LocUi_QueueRowOpen}"
                                AutomationProperties.Name="{DynamicResource LocCtx_OpenPath}"
                                ToolTip="{StaticResource AppTip.QIActionsTpl.1}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FluentQueueRowSubtleActionButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding DataContext.CancelQueueJobCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource LocUi_QueueRowCancel}"
                                Style="{StaticResource FluentQueueRowSubtleActionButton}"
                                AutomationProperties.Name="{DynamicResource LocCtx_CancelJob}"
                                ToolTip="{StaticResource AppTip.QIActionsTpl.2}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="{DynamicResource Inset.0.4.0.0}"
                    Visibility="{Binding UiShowTerminalActionsRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.4}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Height="20"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               Style="{StaticResource FluentQueueCollapsibleDetailText}"
                               Text="{Binding QueueRowDisplayDetailArabic, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                               TextAlignment="Left"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               TextOptions.TextFormattingMode="Display"
                               Typography.NumeralAlignment="Tabular"
                               Typography.NumeralStyle="Lining"
                               NumberSubstitution.Substitution="European"
                               ToolTip="{Binding QueueRowExtendedTooltip}"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Visibility="Collapsed" />

                    <Grid Grid.Column="2"
                          VerticalAlignment="Center"
                          FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource LocUi_QueueRowOpen}"
                                AutomationProperties.Name="{DynamicResource LocCtx_OpenPath}"
                                ToolTip="{StaticResource AppTip.QIActionsTpl.1}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FluentQueueRowSubtleActionButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="2"
                                Style="{StaticResource FluentQueueMetaPillBorder}"
                                Visibility="{Binding HasVerificationResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FluentQueueMetaPillText}"
                                       FlowDirection="{DynamicResource App.FlowDirection}"
                                       Language="{DynamicResource App.XmlLanguage}"
                                       TextAlignment="{DynamicResource App.DefaultTextAlignment}"
                                       Text="{Binding VerificationResultBadgeText, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}" />
                        </Border>

                        <Button Grid.Column="4"
                                Command="{Binding DataContext.OpenOperationLogCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource LocQueue_VerificationResultButton}"
                                AutomationProperties.Name="{DynamicResource LocQueue_VerificationResultButton}"
                                ToolTip="{StaticResource AppTip.QIActionsTpl.3}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FluentQueueRowSubtleActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVerificationResult}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="6"
                                Command="{Binding DataContext.RetryQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                CommandParameter="{Binding}"
                                Content="{DynamicResource LocCtx_Retry}"
                                AutomationProperties.Name="{DynamicResource LocCtx_Retry}"
                                ToolTip="{StaticResource AppTip.QIActionsTpl.4}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource FluentQueueRowSubtleActionButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueRowDisplayState}" Value="Failed">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding QueueRowDisplayState}" Value="Cancelled">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
