<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared chrome for the app's modal dialogs: rounded frame, caption bar,
         content host, action bar and caption title. -->

    <Style x:Key="Win11.DialogRootFrame"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Dialog}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11.DialogTopBar"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.0.0.0.1}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.16.10}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11.DialogActionBar"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource Win11.DialogTopBar}">
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.0.1.0.0}" />
    </Style>

    <Style x:Key="Win11.DialogContentHost"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Layer.Canvas}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.16.All}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11.DialogTitleText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.HeaderTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>
