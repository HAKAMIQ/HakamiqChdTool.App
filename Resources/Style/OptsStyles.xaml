<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
                    xmlns:opt="clr-namespace:HakamiqChdTool.App.Views.Options">

    <Style x:Key="OptionsToolTipStyle"
           TargetType="{x:Type ToolTip}"
           BasedOn="{StaticResource FluentToolTipStyle}">
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
    </Style>

    <Style TargetType="{x:Type ToolTip}"
           BasedOn="{StaticResource OptionsToolTipStyle}" />

    <Style x:Key="HakamiqSettingsPanelCard"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="HakamiqSettingsCard"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.0}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <DataTemplate x:Key="ChoiceOptionLabelTemplate">
        <TextBlock Text="{Binding Label, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                   FontFamily="{DynamicResource FontFamily.Base}"
                   FontSize="{DynamicResource FontSize.BodySmall}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="{DynamicResource Options.SettingsTextAlignment}"
                   FlowDirection="{DynamicResource App.FlowDirection}"
                   Language="{DynamicResource App.XmlLanguage}"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True" />
    </DataTemplate>

    <DataTemplate x:Key="ProcessorOptionLabelTemplate">
        <TextBlock Text="{Binding Label, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                   FontFamily="{DynamicResource FontFamily.Base}"
                   FontSize="{DynamicResource FontSize.BodySmall}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="{DynamicResource Options.SettingsTextAlignment}"
                   FlowDirection="{DynamicResource App.FlowDirection}"
                   Language="{DynamicResource App.XmlLanguage}"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True" />
    </DataTemplate>

    <Style x:Key="AppComboBoxItemStyle"
           TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.8}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.36}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Regular}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control.Large}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          Content="{TemplateBinding Content}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.SelectedBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.SelectedForeground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent.SelectedForeground}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="{DynamicResource Opacity.Disabled.Control}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="AppComboBoxTemplate"
                     TargetType="{x:Type ComboBox}">
        <Grid SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              FlowDirection="{TemplateBinding FlowDirection}"
              Language="{TemplateBinding Language}">

            <Border x:Name="RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                <Grid FlowDirection="{TemplateBinding FlowDirection}"
                      Language="{TemplateBinding Language}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.40}" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter x:Name="ContentSite"
                                      Grid.Column="0"
                                      Margin="{DynamicResource Inset.14.0.14.0}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      FlowDirection="{TemplateBinding FlowDirection}"
                                      Language="{TemplateBinding Language}"
                                      IsHitTestVisible="False"
                                      TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />

                    <TextBox x:Name="PART_EditableTextBox"
                             Grid.Column="0"
                             Margin="{DynamicResource Inset.14.0.14.0}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Background="{DynamicResource Brush.Transparent}"
                             BorderBrush="{DynamicResource Brush.Transparent}"
                             BorderThickness="{DynamicResource Inset.None}"
                             Foreground="{TemplateBinding Foreground}"
                             CaretBrush="{DynamicResource Brush.Text.Primary}"
                             SelectionBrush="{DynamicResource Brush.Accent.Subtle}"
                             SelectionTextBrush="{DynamicResource Brush.Text.Primary}"
                             FlowDirection="{TemplateBinding FlowDirection}"
                             TextAlignment="{DynamicResource Options.SettingsTextAlignment}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{TemplateBinding FontSize}"
                             FontWeight="{TemplateBinding FontWeight}"
                             Language="{TemplateBinding Language}"
                             FocusVisualStyle="{x:Null}"
                             IsReadOnly="{TemplateBinding IsReadOnly}"
                             Visibility="Hidden"
                             SnapsToDevicePixels="True"
                             UseLayoutRounding="True" />

                    <Border x:Name="ArrowBorder"
                            Grid.Column="1"
                            Background="{DynamicResource Brush.Transparent}">
                        <Viewbox x:Name="ArrowIcon"
                                 Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform"
                                 SnapsToDevicePixels="True">
                            <Path x:Name="ArrowGlyph"
                                  Data="{StaticResource Icon.ChevronDown}"
                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                        </Viewbox>
                    </Border>

                    <ToggleButton x:Name="DropDownToggle"
                                  Grid.ColumnSpan="2"
                                  Background="{DynamicResource Brush.Transparent}"
                                  BorderThickness="{DynamicResource Inset.None}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Background="{DynamicResource Brush.Transparent}" />
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=RootBorder}"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border MinWidth="{Binding ActualWidth, ElementName=RootBorder}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="{DynamicResource Inset.0.6.0.0}"
                        Background="{DynamicResource ComboBoxPopupBackgroundBrush}"
                        BorderBrush="{DynamicResource ComboBoxPopupBorderBrush}"
                        BorderThickness="{DynamicResource Inset.1.All}"
                        CornerRadius="{DynamicResource Radius.Menu}"
                        FlowDirection="{TemplateBinding FlowDirection}"
                        Language="{TemplateBinding Language}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <ScrollViewer CanContentScroll="False"
                                  Margin="{DynamicResource Inset.4.All}"
                                  FlowDirection="{TemplateBinding FlowDirection}"
                                  Language="{TemplateBinding Language}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <Border x:Name="Underline"
                    Height="{DynamicResource StrokeThickness.Control}"
                    Margin="{DynamicResource Inset.1.0.1.0}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource Brush.Border.Subtle}"
                    IsHitTestVisible="False"
                    SnapsToDevicePixels="True" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                <Setter TargetName="DropDownToggle" Property="Grid.Column" Value="1" />
                <Setter TargetName="DropDownToggle" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Control.Fill.Hover}" />
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Strong}" />
                <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource Brush.Accent.Text}" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.Control.Stroke.Strong}" />
            </Trigger>

            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Control.Fill.Pressed}" />
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource Brush.Accent.Text}" />
                <Setter TargetName="Underline" Property="Height" Value="2" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
            </Trigger>

            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                <Setter TargetName="Underline" Property="Height" Value="2" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Control.Fill.Disabled}" />
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter TargetName="ArrowGlyph" Property="Fill" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Control.Fill.Rest}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.8.6}" />
        <Setter Property="Template" Value="{StaticResource AppComboBoxTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Regular}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="Win11SettingsPageRoot"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.None}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Win11SettingsScrollViewer"
           TargetType="{x:Type ScrollViewer}">
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsContentStack"
           TargetType="{x:Type StackPanel}">
        <!-- Space between the tab bar and the first heading, and from the window edges. -->
        <Setter Property="Margin" Value="{DynamicResource Inset.16.12}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsSectionHeader"
           TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource Inset.None}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.44}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsSectionTitleText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyStrong}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment" Value="{DynamicResource Options.SettingsTextAlignment}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource Inset.16.10}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsRow"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.0.0.0.1}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.16.10}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.48}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Win11SettingsRowTitleText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment" Value="{DynamicResource Options.SettingsTextAlignment}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsRowDescriptionText"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="TextAlignment" Value="{DynamicResource Options.SettingsTextAlignment}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="{DynamicResource Inset.0.4.0.0}" />
        <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeight.Body}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Win11SettingsTechnicalTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource FluentTechnicalTextBoxStyle}">
        <!-- Path boxes are 32 tall like the buttons beside them; the template already spends 14 of that, so the text gets no
             vertical padding or a 16-pixel line is cut off. -->
        <Setter Property="Padding" Value="{DynamicResource Inset.12.0}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FlowDirection" Value="{DynamicResource TechnicalText.FlowDirection}" />
        <Setter Property="TextAlignment" Value="{DynamicResource TechnicalText.TextAlignment}" />
        <Setter Property="Language" Value="{DynamicResource TechnicalText.Language}" />
    </Style>

    <Style x:Key="Win11SettingsComboBox"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="240" />
        <Setter Property="MaxDropDownHeight" Value="{DynamicResource Options.ComboBox.DropDownMaxHeight}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
    </Style>

    <Style x:Key="Win11SettingsCheckBox"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource FluentCheckBoxStyle}">
        <Setter Property="Width" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Win11SettingsRadioButton"
           TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="{DynamicResource Space.32}" />
        <Setter Property="Height" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CheckBox.Stroke.Rest}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
        <Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="Root"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Ellipse x:Name="Outer"
                                 Width="{DynamicResource Space.18}"
                                 Height="{DynamicResource Space.18}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.CheckBox.Fill.Rest}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1"
                                 SnapsToDevicePixels="True" />

                        <Ellipse x:Name="Inner"
                                 Width="{DynamicResource Space.8}"
                                 Height="{DynamicResource Space.8}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Foreground.OnAccent}"
                                 Visibility="Collapsed"
                                 SnapsToDevicePixels="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Brush.CheckBox.Fill.Hover}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.CheckBox.Stroke.Hover}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Brush.CheckBox.Fill.Pressed}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.CheckBox.Stroke.Pressed}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Brush.CheckBox.Fill.Checked}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.CheckBox.Stroke.Checked}" />
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Brush.CheckBox.Fill.Checked.Hover}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.CheckBox.Stroke.Checked.Hover}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Opacity.Disabled.Control}" />
                            <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Brush.CheckBox.Fill.Disabled}" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Brush.CheckBox.Stroke.Disabled}" />
                            <Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One option row (Views/Options/OptRow.cs): title, description under it, control at the start or end, optional
         area below. Rows are 48 or more tall with 16/12 padding in every tab; a line separates rows inside a card. -->
    <Style TargetType="{x:Type opt:OptRow}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Inset.0.0.0.1}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.16.12}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.48}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type opt:OptRow}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="TextArea"
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           Style="{StaticResource Win11SettingsRowTitleText}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <TextBlock x:Name="DescriptionText"
                                           Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                                           Style="{StaticResource Win11SettingsRowDescriptionText}"
                                           Margin="{DynamicResource Inset.0.2.0.0}"
                                           TextTrimming="None" />
                            </StackPanel>

                            <ContentPresenter x:Name="ControlHost"
                                              Grid.Column="2"
                                              Margin="{DynamicResource Inset.12.0.0.0}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ContentPresenter x:Name="ExtraHost"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              Margin="{DynamicResource Inset.0.8.0.0}"
                                              Content="{TemplateBinding Extra}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Placement" Value="Leading">
                            <Setter TargetName="ControlHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ControlHost" Property="Margin" Value="{DynamicResource Inset.0.0.12.0}" />
                            <Setter TargetName="ControlHost" Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Extra" Value="{x:Null}">
                            <Setter TargetName="ExtraHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextArea" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsFilteredOut" Value="True">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFilteredOut" Value="True">
                <Setter Property="MinHeight" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A group of rows: a small heading above one card. The last row's separator is pushed out of the clipped card. -->
    <Style TargetType="{x:Type opt:OptSection}">
        <Setter Property="Margin" Value="{DynamicResource Inset.0.0.0.24}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type opt:OptSection}">
                    <StackPanel x:Name="Root">
                        <TextBlock x:Name="HeaderText"
                                   Text="{TemplateBinding Header}"
                                   Style="{StaticResource Win11SettingsSectionTitleText}"
                                   Margin="{DynamicResource Inset.0.0.0.8}" />
                        <!-- A folding section: the heading is a button with an arrow. -->
                        <ToggleButton x:Name="HeaderToggle"
                                      Visibility="Collapsed"
                                      Margin="{DynamicResource Inset.0.0.0.8}"
                                      HorizontalAlignment="Left"
                                      Cursor="Hand"
                                      Focusable="True"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      AutomationProperties.Name="{TemplateBinding Header}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{DynamicResource Brush.Transparent}" Padding="{DynamicResource Inset.0.2.0.0}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Arrow"
                                                  Width="{DynamicResource Space.10}"
                                                  Height="{DynamicResource Space.10}"
                                                  Margin="{DynamicResource Inset.0.0.6.0}"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource Icon.ChevronDown}"
                                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                                  Stretch="Uniform"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="-90" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <TextBlock Text="{TemplateBinding Header}"
                                       Style="{StaticResource Win11SettingsSectionTitleText}"
                                       Margin="{DynamicResource Inset.None}" />
                        </ToggleButton>
                        <Border x:Name="Card"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="{DynamicResource Inset.1.All}"
                                CornerRadius="{DynamicResource Radius.Card.Large}"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <ItemsPresenter Margin="0,0,0,-1" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCollapsible" Value="True">
                            <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderToggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCollapsible" Value="True" />
                                <Condition Property="IsExpanded" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsFilteredOut" Value="True">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFilteredOut" Value="True">
                <Setter Property="Margin" Value="{DynamicResource Inset.None}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- What is wrong with the field above it; hidden while there is nothing to say. -->
    <Style x:Key="OptFieldError" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Margin" Value="{DynamicResource Inset.0.4.0.0}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Folder box with its Browse button, under an option row. -->
    <Style x:Key="OptPathButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Height" Value="{DynamicResource Space.32}" />
        <Setter Property="Margin" Value="{DynamicResource Inset.8.0.0.0}" />
    </Style>
</ResourceDictionary>