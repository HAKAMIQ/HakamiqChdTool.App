<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore">

    <Style x:Key="FluentButtonBaseStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentSecondaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.6}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
        <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentPrimaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.6}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentSecondaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.6}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubtleButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentGhostButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.10.6}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    </Style>

    <Style x:Key="OutlineButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentSecondaryButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.6}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Default}" />
    </Style>

    <Style x:Key="TransparentButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentGhostButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.10.6}" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentDestructiveButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.12.6}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
    </Style>

    <Style x:Key="HeaderIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentHeaderGhostButton}">
        <Setter Property="Width" Value="{DynamicResource Space.32}" />
        <Setter Property="Height" Value="{DynamicResource Space.32}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Language" Value="en-US" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.HeaderButton}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="LeftToRight"
                                          Language="en-US"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          SnapsToDevicePixels="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Transparent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SocialLinkButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentToolButton}">
        <Setter Property="Width" Value="{DynamicResource Space.36}" />
        <Setter Property="Height" Value="{DynamicResource Space.36}" />
        <Setter Property="MinWidth" Value="{DynamicResource Space.36}" />
        <Setter Property="MinHeight" Value="{DynamicResource Space.36}" />
        <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
        <Setter Property="Margin" Value="{DynamicResource Inset.4.All}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Language" Value="en-US" />
        <Setter Property="Cursor" Value="{x:Static input:Cursors.Hand}" />
    </Style>

</ResourceDictionary>
