<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/Fluent/BaseStyles.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style x:Key="FluentButtonBaseStyle"
           TargetType="{x:Type Button}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
		<Setter Property="MinWidth" Value="{DynamicResource Space.80}" />
		<Setter Property="Padding" Value="12,5" />
		<Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
		<Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
		<Setter Property="FontFamily" Value="{DynamicResource FontFamily.Base}" />
		<Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
		<Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisualStyle}" />
	</Style>

	<Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButtonBaseStyle}">
		<Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.OnAccent}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Disabled}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
							<Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
							<Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButtonBaseStyle}">
		<Setter Property="Background" Value="{DynamicResource Brush.Control.Fill.Rest}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Default}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Hover}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Strong}" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Pressed}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Disabled}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
							<Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
							<Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="TransparentButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButtonBaseStyle}">
		<Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
		<Setter Property="MinWidth" Value="{DynamicResource Space.64}" />
		<Setter Property="Padding" Value="{DynamicResource Inset.8.4}" />
		<Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
		<Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Hover}" />
							<Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Pressed}" />
							<Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
							<Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButtonBaseStyle}">
		<Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="{TemplateBinding FlowDirection}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Control.Fill.Disabled}" />
							<Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
							<Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
							<Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

        <Style x:Key="HeaderIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource FluentButtonBaseStyle}">
                <Setter Property="Width" Value="{DynamicResource Space.32}" />
                <Setter Property="Height" Value="{DynamicResource Space.32}" />
                <Setter Property="MinWidth" Value="{DynamicResource Space.32}" />
                <Setter Property="MinHeight" Value="{DynamicResource Space.32}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="Template">
                        <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.HeaderButton}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          FlowDirection="LeftToRight"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="True" />
                                        </Border>

                                        <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
                                                </Trigger>

                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                                                </Trigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                                                        <Setter Property="Cursor" Value="{x:Static input:Cursors.Arrow}" />
                                                </Trigger>
                                        </ControlTemplate.Triggers>
                                </ControlTemplate>
                        </Setter.Value>
                </Setter>
        </Style>

</ResourceDictionary>
