<UserControl x:Class="HakamiqChdTool.App.Views.Main.MainHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ToolTip x:Key="AppTip.MainHeaderView.1"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocGeneralSettings_LanguageTitle}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.MainHeaderView.2"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocGeneralSettings_ThemeDescription}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.MainHeaderView.3"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocUi_Header_Minimize}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.MainHeaderView.4"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocUi_Header_Maximize}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.MainHeaderView.5"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocUi_Header_Close}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>
        <Style x:Key="MainHeaderBrandGroup"
               TargetType="{x:Type Grid}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MainHeaderTitleColumn"
               TargetType="{x:Type StackPanel}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MainHeaderGeneralText"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Text}" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <Style x:Key="MainHeaderTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MainHeaderGeneralText}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MainHeaderSubtitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MainHeaderGeneralText}">
            <Setter Property="Margin" Value="{DynamicResource Inset.0.2.0.0}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.CaptionSmall}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MainHeaderButtonText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MainHeaderGeneralText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MainHeaderLogoSurface"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="{DynamicResource Space.40}" />
            <Setter Property="Height" Value="{DynamicResource Space.40}" />
            <Setter Property="Background" Value="{DynamicResource HeaderLogoPlateBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderLogoPlateBorderBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card.Medium}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="MainHeaderDivider"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="{DynamicResource StrokeThickness.Control}" />
            <Setter Property="Height" Value="{DynamicResource Space.20}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="Opacity" Value="{DynamicResource Opacity.Divider.Subtle}" />
        </Style>

        <Style x:Key="MainHeaderGhostButton"
               TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="{DynamicResource Inset.10.5}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Text}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSize.CaptionSmall}" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Fill.Hover}" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.Border.Subtle}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Fill.Pressed}" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.Border.Subtle}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainHeaderLanguageButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MainHeaderGhostButton}">
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Padding" Value="{DynamicResource Inset.8.4}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Language" Value="en-US" />
        </Style>

        <Style x:Key="MainHeaderLanguageButtonText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource MainHeaderButtonText}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Language" Value="en-US" />
            <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
        </Style>

        <Style x:Key="MainHeaderCommandCluster"
               TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Inset.None}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.None}" />
            <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MainHeaderCaptionBtnStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="{DynamicResource Space.56}" />
            <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Inset.None}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Width="{DynamicResource Space.32}"
                                Height="{DynamicResource Space.32}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.HeaderButton}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.HoverSurface}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.PressedSurface}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainHeaderCaptionCloseBtnStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MainHeaderCaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Width="{DynamicResource Space.32}"
                                Height="{DynamicResource Space.32}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.HeaderButton}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource ButtonDangerBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ButtonDangerForegroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource ButtonDangerPressedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ButtonDangerForegroundBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Layer.Surface}"
            BorderBrush="{DynamicResource Brush.Transparent}"
            BorderThickness="{DynamicResource Inset.None}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource Grid.Space.56}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="{DynamicResource Inset.16.0.16.0}"
                  VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      MinWidth="0"
                      Style="{StaticResource MainHeaderBrandGroup}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource MainHeaderLogoSurface}">
                        <Image Width="32"
                               Height="32"
                               Margin="{DynamicResource Inset.None}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                MinWidth="0"
                                Style="{StaticResource MainHeaderTitleColumn}">
                        <TextBlock Style="{StaticResource MainHeaderTitleText}"
                                   Text="{DynamicResource LocUi_WindowTitle}" />

                    </StackPanel>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource MainHeaderCommandCluster}">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.2}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.2}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.2}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="HeaderSettingsButton"
                                Grid.Column="0"
                                Command="{Binding OpenOptionsCommand}"
                                Style="{StaticResource MainHeaderGhostButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="{DynamicResource LocUi_Header_Settings}"
                                       Style="{StaticResource MainHeaderButtonText}" />
                        </Button>

                        <Button x:Name="HeaderLanguageButton"
                                Grid.Column="2"
                                Click="ForwardLanguageToggleRequested"
                                Style="{StaticResource MainHeaderLanguageButton}"
                                ToolTip="{StaticResource AppTip.MainHeaderView.1}"
                                AutomationProperties.Name="{DynamicResource LocGeneralSettings_LanguageTitle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="HeaderLanguageText"
                                       Text="EN"
                                       Style="{StaticResource MainHeaderLanguageButtonText}" />
                        </Button>

                        <Button x:Name="HeaderThemeButton"
                                Grid.Column="4"
                                Click="ThemeCycleButton_Click"
                                Style="{StaticResource MainHeaderLanguageButton}"
                                ToolTip="{StaticResource AppTip.MainHeaderView.2}"
                                AutomationProperties.Name="{DynamicResource LocGeneralSettings_ThemeTitle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="HeaderThemeText"
                                       Text="🌙"
                                       Style="{StaticResource MainHeaderLanguageButtonText}" />
                        </Button>

                        <Button x:Name="HeaderAboutButton"
                                Grid.Column="6"
                                Command="{Binding OpenAboutCommand}"
                                Style="{StaticResource MainHeaderGhostButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="{DynamicResource LocUi_Header_About}"
                                       Style="{StaticResource MainHeaderButtonText}" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource MainHeaderDivider}" />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button x:Name="CaptionMinimizeButton"
                            ToolTip="{StaticResource AppTip.MainHeaderView.3}"
                            Click="ForwardMinimizeRequested"
                            Style="{StaticResource MainHeaderCaptionBtnStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 Stretch="Uniform"
                                 FlowDirection="LeftToRight">
                            <Path Data="{StaticResource Icon.Minimize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="CaptionMaximizeRestoreButton"
                            ToolTip="{StaticResource AppTip.MainHeaderView.4}"
                            Click="ForwardMaximizeRestoreRequested"
                            Style="{StaticResource MainHeaderCaptionBtnStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 Stretch="Uniform"
                                 FlowDirection="LeftToRight">
                            <Path x:Name="CaptionMaximizeRestorePath"
                                  Data="{StaticResource Icon.Maximize}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="CaptionCloseButton"
                            ToolTip="{StaticResource AppTip.MainHeaderView.5}"
                            Click="ForwardCloseRequested"
                            Style="{StaticResource MainHeaderCaptionCloseBtnStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 Stretch="Uniform"
                                 FlowDirection="LeftToRight">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Height="{DynamicResource StrokeThickness.Control}"
                    Background="{DynamicResource Brush.Border.Subtle}"
                    Opacity="{DynamicResource Opacity.Divider.Subtle}" />
        </Grid>
    </Border>
</UserControl>
