<UserControl x:Class="HakamiqChdTool.App.Views.Main.QueueEmptyStateView"
             x:Name="QueueEmptyStateRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             Background="{x:Null}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid MaxWidth="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="Transparent"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{DynamicResource Grid.Space.16}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Width="{DynamicResource Space.56}"
                Height="{DynamicResource Space.56}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Accent.Subtle}"
                BorderBrush="{DynamicResource Brush.Accent.SelectedBorder}"
                BorderThickness="{DynamicResource Inset.1.All}"
                CornerRadius="{DynamicResource Radius.Card.Large}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

            <Viewbox Width="{DynamicResource Space.20}"
                     Height="{DynamicResource Space.20}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FlowDirection="LeftToRight"
                     Stretch="Uniform">

                <Path Fill="{DynamicResource Brush.Accent.Text}"
                      Stretch="Uniform"
                      SnapsToDevicePixels="True">

                    <Path.Style>
                        <Style TargetType="{x:Type Path}">
                            <Setter Property="Data"
                                    Value="{StaticResource Icon.Operation.Convert}" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                             Value="Extract">
                                    <Setter Property="Data"
                                            Value="{StaticResource Icon.Operation.Extract}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                             Value="Verify">
                                    <Setter Property="Data"
                                            Value="{StaticResource Icon.Operation.Verify}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                             Value="ScanConvert">
                                    <Setter Property="Data"
                                            Value="{StaticResource Icon.DatabaseSearch}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                             Value="ScanExtract">
                                    <Setter Property="Data"
                                            Value="{StaticResource Icon.FolderZip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Viewbox>
        </Border>

        <TextBlock Grid.Row="2"
                   MaxWidth="480"
                   Margin="{DynamicResource Inset.16.0}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontFamily.Text}"
                   FontSize="{DynamicResource FontSize.BodyStrong}"
                   FontWeight="{DynamicResource FontWeight.SemiBold}"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   LineHeight="{DynamicResource Font.LineHeight.Body}"
                   LineStackingStrategy="BlockLineHeight"
                   TextAlignment="Left"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True">

            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Text"
                            Value="{DynamicResource LocUi_DropZone_Convert}" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                     Value="Extract">
                            <Setter Property="Text"
                                    Value="{DynamicResource LocUi_DropZone_Extract}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                     Value="Verify">
                            <Setter Property="Text"
                                    Value="{DynamicResource LocUi_DropZone_Verify}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                     Value="ScanConvert">
                            <Setter Property="Text"
                                    Value="{DynamicResource LocUi_DropZone_ScanConvert}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding OperationModeKey, ElementName=QueueEmptyStateRoot}"
                                     Value="ScanExtract">
                            <Setter Property="Text"
                                    Value="{DynamicResource LocUi_DropZone_ScanExtract}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>