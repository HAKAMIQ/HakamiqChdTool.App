<UserControl x:Class="HakamiqChdTool.App.Views.Main.ActionRailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mainViews="clr-namespace:HakamiqChdTool.App.Views.Main"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Focusable="False">

    <Grid ClipToBounds="True">
        <ScrollViewer Margin="{DynamicResource Inset.4.All}"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      Focusable="False">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{DynamicResource Grid.Space.16}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <mainViews:OperationModePanel x:Name="ModePanel"
                                              Grid.Row="0"
                                              OperationModeChanged="OnOperationModeChanged" />

                <Border Grid.Row="1"
                        Height="{DynamicResource StrokeThickness.Control}"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Subtle}"
                        Opacity="{DynamicResource Opacity.Divider.Subtle}" />

                <mainViews:ProcessingActionsPanel x:Name="ActionsPanel"
                                                  Grid.Row="2" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>