<UserControl x:Class="HakamiqChdTool.App.Views.Main.FooterStatusStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Thickness x:Key="Footer.Root.Padding">16,5,16,5</Thickness>
        <Thickness x:Key="Footer.Chip.Padding">4,2,4,2</Thickness>
        <Thickness x:Key="Footer.Hairline">1</Thickness>

        <CornerRadius x:Key="Footer.Chip.Radius">8</CornerRadius>
        <CornerRadius x:Key="Footer.Dot.Radius">4</CornerRadius>

        <Style x:Key="FooterTextBase"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontFamily.Text}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="{DynamicResource FontSize.CaptionSmall}" />
            <Setter Property="TextAlignment"
                    Value="Left" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FooterStateText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FooterTextBase}">
            <Setter Property="FontWeight"
                    Value="{DynamicResource FontWeight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style x:Key="FooterMessageText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FooterTextBase}">
            <Setter Property="FontWeight"
                    Value="{DynamicResource FontWeight.Medium}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="FooterTechnicalText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource FooterTextBase}">
            <Setter Property="FlowDirection"
                    Value="{DynamicResource TechnicalText.FlowDirection}" />
            <Setter Property="Language"
                    Value="{DynamicResource TechnicalText.Language}" />
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontFamily.Mono}" />
            <Setter Property="FontWeight"
                    Value="{DynamicResource FontWeight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Accent.Text}" />
        </Style>

        <Style x:Key="FooterChipSurface"
               TargetType="{x:Type Border}">
            <Setter Property="Padding"
                    Value="{StaticResource Footer.Chip.Padding}" />
            <Setter Property="CornerRadius"
                    Value="{StaticResource Footer.Chip.Radius}" />
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness"
                    Value="{DynamicResource Inset.None}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>

        <Style x:Key="FooterProgressSurface"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource FooterChipSurface}">
            <Setter Property="MinWidth"
                    Value="260" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainFooterStatusStrip"
            Style="{StaticResource FluentFooterSessionCapsule}"
            Padding="{StaticResource Footer.Root.Padding}">

        <Grid VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FooterStatsPanel"
                  Grid.Column="0"
                  Width="0"
                  Height="0"
                  Visibility="Collapsed">

                <TextBlock x:Name="FooterWaitingCountText"
                           Text="0" />

                <TextBlock x:Name="FooterActiveCountText"
                           Text="0" />

                <TextBlock x:Name="FooterCompletedCountText"
                           Text="0" />

                <TextBlock x:Name="FooterFailedCountText"
                           Text="0" />

                <TextBlock x:Name="FooterSkippedCountText"
                           Text="0" />
            </Grid>

            <Grid Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource FooterChipSurface}">

                    <Grid VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="FooterStateDot"
                                Grid.Column="0"
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource Footer.Dot.Radius}"
                                Background="{DynamicResource Brush.Accent.Text}" />

                        <TextBlock x:Name="FooterStateText"
                                   Grid.Column="2"
                                   Style="{StaticResource FooterStateText}"
                                   Text="{DynamicResource LocFooter_StateReady}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="FooterQueueSummaryText"
                           Grid.Column="2"
                           MinWidth="0"
                           MaxWidth="{DynamicResource Layout.ToolTip.MaxWidth}"
                           VerticalAlignment="Center"
                           Style="{StaticResource FooterMessageText}"
                           Text="{DynamicResource LocFooter_IdleNoTasks}" />
            </Grid>

            <Grid Grid.Column="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource FooterProgressSurface}"
                        Visibility="{Binding Visibility, ElementName=FooterProgressStrip}">

                    <Grid x:Name="FooterProgressStrip"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FooterSessionPhaseText"
                                   Grid.Column="0"
                                   MaxWidth="{DynamicResource Footer.Phase.MaxWidth}"
                                   Style="{StaticResource FooterStateText}" />

                        <ProgressBar x:Name="QueueProgressBar"
                                     Grid.Column="2"
                                     Width="{DynamicResource Footer.Progress.Width}"
                                     Minimum="{DynamicResource Progress.Minimum}"
                                     Maximum="{DynamicResource Progress.Maximum}"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource FluentQueueCardProgressBar}" />

                        <TextBlock x:Name="QueueProgressText"
                                   Grid.Column="4"
                                   Style="{StaticResource FooterTechnicalText}"
                                   Text="&#x200E;0%" />
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusBarSettingsText"
                           Grid.Column="2"
                           MaxWidth="{DynamicResource Footer.Settings.MaxWidth}"
                           Style="{StaticResource FooterMessageText}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>