<UserControl x:Class="HakamiqChdTool.App.Views.Main.ProcessingActionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ToolTip x:Key="AppTip.ProcActions.1"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocRedump_Tool_Subtitle}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.ProcActions.2"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocRedump_Tool_VerifySelectedTooltip}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>

        <ToolTip x:Key="AppTip.ProcActions.3"
                 x:Shared="False"
                 FlowDirection="{DynamicResource App.FlowDirection}"
                 Language="{DynamicResource App.XmlLanguage}"
                 Content="{DynamicResource LocRedump_Tool_VerifyAllTooltip}">
            <ToolTip.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="{DynamicResource FontFamily.Base}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FlowDirection="{DynamicResource App.FlowDirection}"
                               Language="{DynamicResource App.XmlLanguage}"
                               TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                </DataTemplate>
            </ToolTip.ContentTemplate>
        </ToolTip>
        <Style x:Key="ProcessingActionsPanelText"
               TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily"
                    Value="{DynamicResource FontFamily.Text}" />
            <Setter Property="TextAlignment"
                    Value="Left" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="ToolTipService.ShowDuration"
                    Value="{DynamicResource ToolTip.ShowDuration.Long}" />
        </Style>

        <Style x:Key="ProcessingActionsPanelHeaderTitleText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource ProcessingActionsPanelText}">
            <Setter Property="FontSize"
                    Value="{DynamicResource FontSize.BodyStrong}" />
            <Setter Property="FontWeight"
                    Value="{DynamicResource FontWeight.SemiBold}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
        </Style>

        <Style x:Key="ProcessingActionsPanelActionChipText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource ProcessingActionsPanelText}">
            <Setter Property="FontSize"
                    Value="{DynamicResource FontSize.Body}" />
            <Setter Property="FontWeight"
                    Value="{DynamicResource FontWeight.Regular}" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
        </Style>

        <Style x:Key="ProcessingActionsPanelActionChip"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness"
                    Value="{DynamicResource Inset.None}" />
            <Setter Property="Padding"
                    Value="{DynamicResource Inset.8.4}" />
            <Setter Property="Cursor"
                    Value="{x:Static input:Cursors.Hand}" />
            <Setter Property="MinHeight"
                    Value="{DynamicResource Space.40}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource FluentFocusVisualStyle}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <Grid FlowDirection="{TemplateBinding FlowDirection}"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Style="{StaticResource ProcessingActionsPanelActionChipText}" />

                                <Border x:Name="IconPlate"
                                        Grid.Column="2"
                                        Width="{DynamicResource Space.24}"
                                        Height="{DynamicResource Space.24}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Transparent}"
                                        CornerRadius="{DynamicResource Radius.Control}">

                                    <Viewbox Width="{DynamicResource Space.20}"
                                             Height="{DynamicResource Space.20}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FlowDirection="LeftToRight"
                                             Stretch="Uniform">

                                        <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              Fill="{TemplateBinding Foreground}"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                               Value="True" />
                                    <Condition Property="IsEnabled"
                                               Value="True" />
                                </MultiTrigger.Conditions>

                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Brush.HoverSurface}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />
                            </MultiTrigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Brush.PressedSurface}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Primary}" />

                                <Setter TargetName="IconPlate"
                                        Property="Background"
                                        Value="{DynamicResource Brush.HoverSurface}" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Transparent}" />

                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.Text.Disabled}" />

                                <Setter Property="Cursor"
                                        Value="{x:Static input:Cursors.Arrow}" />

                                <Setter TargetName="IconPlate"
                                        Property="Opacity"
                                        Value="0.50" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource FluentActionCard}"
            Padding="{DynamicResource Inset.8.All}"
            Background="{DynamicResource Brush.Transparent}"
            BorderBrush="{DynamicResource Brush.Transparent}"
            BorderThickness="{DynamicResource Inset.None}"
            Visibility="{Binding IsRedumpFeatureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.4}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="{DynamicResource Inset.4.0}"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="0"
                        Height="14"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Transparent}"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Opacity="{DynamicResource Opacity.Subtle}" />

                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="3"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource LocRedump_Tool_Title}"
                           ToolTip="{StaticResource AppTip.ProcActions.1}"
                           TextAlignment="Center"
                           Style="{StaticResource ProcessingActionsPanelHeaderTitleText}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </Grid>

            <Button Grid.Row="2"
                    Command="{Binding VerifySelectedRedumpToolbarCommand}"
                    Tag="{StaticResource Icon.DatabaseSearch}"
                    Content="{DynamicResource LocRedump_Tool_VerifySelected}"
                    ToolTip="{StaticResource AppTip.ProcActions.2}"
                    ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource ProcessingActionsPanelActionChip}" />

            <Button Grid.Row="4"
                    Command="{Binding VerifyAllRedumpToolbarCommand}"
                    Tag="{StaticResource Icon.Operation.Verify}"
                    Content="{DynamicResource LocRedump_Tool_VerifyAll}"
                    ToolTip="{StaticResource AppTip.ProcActions.3}"
                    ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource ProcessingActionsPanelActionChip}" />
        </Grid>
    </Border>
</UserControl>
