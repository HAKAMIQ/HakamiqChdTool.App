<UserControl x:Class="HakamiqChdTool.App.Views.Main.QueueWorkspaceView"
             x:Name="QueueWorkspaceRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:HakamiqChdTool.App.Views.Main"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Border x:Name="WorkspaceCardRoot"
            AllowDrop="True"
            Drop="ForwardWorkspaceDrop"
            PreviewDragOver="ForwardWorkspacePreviewDragOver"
            PreviewDragLeave="ForwardWorkspacePreviewDragLeave"
            PreviewDrop="ForwardWorkspacePreviewDrop"
            Style="{StaticResource FluentWorkspaceCard}"
            CornerRadius="{DynamicResource Radius.None}"
            Background="{DynamicResource Brush.Layer.Surface}"
            ClipToBounds="True">

        <Grid Background="{DynamicResource Brush.Layer.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <main:QueueToolbarView Grid.Row="0" />

            <Border x:Name="RunSummaryBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="{DynamicResource Inset.12.8}"
                    Padding="{DynamicResource Inset.12.8}"
                    Background="{DynamicResource Brush.Layer.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Control.Large}"
                    AutomationProperties.AutomationId="RunSummaryBar"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{Binding Text, ElementName=RunSummaryTitleText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Width="{DynamicResource Space.18}"
                             Height="{DynamicResource Space.18}"
                             VerticalAlignment="Center"
                             FlowDirection="LeftToRight"
                             Stretch="Uniform">
                        <Path x:Name="RunSummaryIcon"
                              Data="{StaticResource Icon.Success}"
                              Fill="{DynamicResource Brush.Success}"
                              Stretch="Uniform" />
                    </Viewbox>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="RunSummaryTitleText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RunSummaryMessageText"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button x:Name="RunSummaryDetailsButton"
                            Grid.Column="4"
                            MinWidth="72"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Click="RunSummaryDetailsButton_Click"
                            Style="{StaticResource QueueWorkspaceFooterSecondaryCommand}"
                            AutomationProperties.AutomationId="RunSummaryDetailsButton"
                            AutomationProperties.Name="{DynamicResource LocRunSummary_Details}">
                        <TextBlock Style="{StaticResource QueueWorkspaceCommandText}"
                                   Text="{DynamicResource LocRunSummary_Details}"
                                   TextAlignment="Center" />
                    </Button>

                    <Button x:Name="RunSummaryCloseButton"
                            Grid.Column="6"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Click="RunSummaryCloseButton_Click"
                            Style="{StaticResource TransparentButtonStyle}"
                            ToolTip="{DynamicResource LocRunSummary_Close}"
                            AutomationProperties.AutomationId="RunSummaryCloseButton"
                            AutomationProperties.Name="{DynamicResource LocRunSummary_Close}">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="QueueHostSurface"
                  Grid.Row="2"
                  MinHeight="{DynamicResource Layout.Queue.MinHeight}"
                  Background="{DynamicResource Brush.Layer.Canvas}"
                  ClipToBounds="True">

                <Grid>
                    <Rectangle x:Name="DropZoneDashedFrame"
                               Margin="{DynamicResource Inset.12.All}"
                               RadiusX="10"
                               RadiusY="10"
                               Stroke="{DynamicResource DropZoneBorderBrush}"
                               StrokeDashArray="{DynamicResource StrokeDash.DropZone}"
                               StrokeThickness="1"
                               IsHitTestVisible="False">

                        <Rectangle.Style>
                            <Style TargetType="{x:Type Rectangle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TaskGrid.HasItems, ElementName=QueueListSection}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <main:QueueListView x:Name="QueueListSection"
                                        TaskGridDrop="ForwardWorkspaceDrop"
                                        TasksLoadingRow="ForwardTasksLoadingRow"
                                        TasksUnloadingRow="ForwardTasksUnloadingRow"
                                        TasksScrollChanged="ForwardTasksScrollChanged"
                                        TasksPreviewMouseRightButtonDown="ForwardTasksPreviewMouseRightButtonDown"
                                        TasksMouseDoubleClick="ForwardTasksMouseDoubleClick"
                                        TasksSelectionChanged="ForwardTasksSelectionChanged"
                                        QueueContextMenuOpened="ForwardQueueContextMenuOpened" />

                    <Border x:Name="EmptyQueueDropHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="{DynamicResource Panel.ZIndex.Overlay}"
                            IsHitTestVisible="False"
                            Padding="{DynamicResource Inset.24.All}">

                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TaskGrid.HasItems, ElementName=QueueListSection}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <main:QueueEmptyStateView OperationModeKey="{Binding OperationModeKey, ElementName=QueueWorkspaceRoot}" />
                    </Border>
                </Grid>

                <Border x:Name="DropHighlightOverlay"
                        Margin="{DynamicResource Inset.12.All}"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="{DynamicResource Radius.Card.Large}"
                        IsHitTestVisible="False"
                        Opacity="{DynamicResource Opacity.Hidden}"
                        Panel.ZIndex="{DynamicResource Panel.ZIndex.Overlay}" />
            </Grid>

            <Border Grid.Row="3"
                    Padding="{DynamicResource Inset.12.8}"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AfterRunComboBox"
                              Grid.Column="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              MinWidth="150"
                              MinHeight="32"
                              SelectedIndex="0"
                              ToolTip="{DynamicResource LocAfterRun_Tip}"
                              AutomationProperties.AutomationId="AfterRunComboBox"
                              AutomationProperties.Name="{DynamicResource LocAfterRun_Label}">
                        <ComboBoxItem Tag="None" Content="{DynamicResource LocAfterRun_None}" />
                        <ComboBoxItem Tag="Sleep" Content="{DynamicResource LocAfterRun_Sleep}" />
                        <ComboBoxItem Tag="Shutdown" Content="{DynamicResource LocAfterRun_Shutdown}" />
                    </ComboBox>

                    <Border Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="{DynamicResource Inset.None}"
                            Background="{DynamicResource Brush.Transparent}"
                            BorderBrush="{DynamicResource Brush.Transparent}"
                            BorderThickness="{DynamicResource Inset.None}"
                            CornerRadius="{DynamicResource Radius.Control.Large}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    MinWidth="104"
                                    MinHeight="32"
                                    Command="{Binding StartProcessingCommand}"
                                    Style="{StaticResource QueueWorkspaceFooterPrimaryCommand}"
                                    AutomationProperties.Name="{DynamicResource LocUi_Hub_StartProcessing}">

                                <TextBlock Style="{StaticResource QueueWorkspaceCommandText}"
                                           Text="{DynamicResource LocUi_Hub_StartProcessing}"
                                           TextAlignment="Center" />
                            </Button>

                            <Button Grid.Column="2"
                                    MinWidth="72"
                                    MinHeight="32"
                                    Command="{Binding CancelProcessingCommand}"
                                    Style="{StaticResource QueueWorkspaceFooterDangerCommand}"
                                    AutomationProperties.Name="{DynamicResource LocUi_Hub_Stop}">

                                <TextBlock Style="{StaticResource QueueWorkspaceCommandText}"
                                           Text="{DynamicResource LocUi_Hub_Stop}"
                                           TextAlignment="Center" />
                            </Button>

                            <Button Grid.Column="4"
                                    MinWidth="88"
                                    MinHeight="32"
                                    Command="{Binding ClearQueueCommand}"
                                    Style="{StaticResource QueueWorkspaceFooterSecondaryCommand}"
                                    AutomationProperties.Name="{DynamicResource LocUi_Hub_ClearQueue}">

                                <TextBlock Style="{StaticResource QueueWorkspaceCommandText}"
                                           Text="{DynamicResource LocUi_Hub_ClearQueue}"
                                           TextAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
