<UserControl x:Class="HakamiqChdTool.App.Views.Main.QueueToolbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Border Style="{DynamicResource FluentQueueWorkspaceHeader}"
            Padding="{DynamicResource Inset.16.12}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="{DynamicResource Space.32}"
                        Height="{DynamicResource Space.32}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Layer.Canvas}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="{DynamicResource Inset.1.All}"
                        CornerRadius="{DynamicResource Radius.Control.Large}">

                    <Viewbox Width="{DynamicResource Space.18}"
                             Height="{DynamicResource Space.18}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FlowDirection="LeftToRight"
                             Stretch="Uniform">

                        <Path Data="{StaticResource Icon.DocumentAdd}"
                              Fill="{DynamicResource Brush.Accent.Text}"
                              Stretch="Uniform" />
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="2"
                            Style="{DynamicResource QueueWorkspaceHeaderTextColumn}">

                    <TextBlock Style="{DynamicResource QueueWorkspaceHeaderTitleText}"
                               Text="{DynamicResource LocUi_QueueSection_Title}"
                               TextAlignment="Left" />

                    <TextBlock Text="{DynamicResource LocUi_QueueSection_Subtitle}"
                               TextAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource QueueWorkspaceHeaderSubtitleText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QueueItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding SelectFilesCommand}"
                        IsEnabled="{Binding IsShellEnabled}"
                        Style="{DynamicResource QueueWorkspaceToolButton}"
                        AutomationProperties.Name="{DynamicResource LocUi_Hub_AddFiles}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="{DynamicResource Space.16}"
                                 Height="{DynamicResource Space.16}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">

                            <Path Data="{StaticResource Icon.DocumentAdd}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>

                        <TextBlock Grid.Column="2"
                                   Style="{DynamicResource QueueWorkspaceCommandText}"
                                   Text="{DynamicResource LocUi_Hub_AddFiles}"
                                   TextAlignment="Left" />
                    </Grid>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding SelectFolderCommand}"
                        IsEnabled="{Binding IsShellEnabled}"
                        Style="{DynamicResource QueueWorkspaceToolButton}"
                        AutomationProperties.Name="{DynamicResource LocUi_Hub_AddFolder}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Width="{DynamicResource Space.16}"
                                 Height="{DynamicResource Space.16}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">

                            <Path Data="{StaticResource Icon.FolderAdd}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>

                        <TextBlock Grid.Column="2"
                                   Style="{DynamicResource QueueWorkspaceCommandText}"
                                   Text="{DynamicResource LocUi_Hub_AddFolder}"
                                   TextAlignment="Left" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>