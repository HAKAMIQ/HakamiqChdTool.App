<Window x:Class="HakamiqChdTool.App.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:options="clr-namespace:HakamiqChdTool.App.Views.Options"
        Title="{DynamicResource LocOptions_WindowTitle}"
        Width="700"
        Height="600"
        MinWidth="680"
        MinHeight="440"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Icon="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.ico"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamily.Text}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ToolTip x:Key="AppTip.OptionsWindow.1"
                     x:Shared="False"
                     FlowDirection="{DynamicResource App.FlowDirection}"
                     Language="{DynamicResource App.XmlLanguage}"
                     Content="{DynamicResource LocCommon_Close}">
                <ToolTip.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                                   MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                    </DataTemplate>
                </ToolTip.ContentTemplate>
            </ToolTip>

            <CornerRadius x:Key="Radius.Control">0</CornerRadius>
            <CornerRadius x:Key="Radius.Control.Small">0</CornerRadius>
            <CornerRadius x:Key="Radius.Control.Large">0</CornerRadius>
            <CornerRadius x:Key="Radius.Input">0</CornerRadius>
            <CornerRadius x:Key="Radius.Button">0</CornerRadius>
            <CornerRadius x:Key="Radius.ComboBox">0</CornerRadius>
            <CornerRadius x:Key="Radius.CheckBox">0</CornerRadius>
            <CornerRadius x:Key="Radius.Card">0</CornerRadius>
            <CornerRadius x:Key="Radius.Card.Medium">0</CornerRadius>
            <CornerRadius x:Key="Radius.Card.Large">0</CornerRadius>
            <CornerRadius x:Key="Radius.Card.Dialog">0</CornerRadius>
            <CornerRadius x:Key="Radius.Overlay">0</CornerRadius>
            <CornerRadius x:Key="Radius.Flyout">0</CornerRadius>
            <CornerRadius x:Key="Radius.Menu">0</CornerRadius>
            <CornerRadius x:Key="Radius.ToolTip">0</CornerRadius>
            <CornerRadius x:Key="Radius.HeaderButton">0</CornerRadius>
            <CornerRadius x:Key="Radius.HeaderCluster">0</CornerRadius>
            <CornerRadius x:Key="Radius.HeaderLogo">0</CornerRadius>

            <Geometry x:Key="OptionsWindow.Icon.Extensions">M0,0 H5 V5 H0 Z M7,0 H12 V5 H7 Z M0,7 H5 V12 H0 Z M7,7 H12 V12 H7 Z</Geometry>

            <Style x:Key="OptionsWindow.RootFrame"
                   TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Brush.Layer.Canvas}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.None}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <Style x:Key="OptionsWindow.TopBar"
                   TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.16.8}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <Style x:Key="OptionsWindow.SidebarPanel"
                   TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.None}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.12.All}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <Style x:Key="OptionsWindow.ContentPanel"
                   TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="BorderThickness" Value="{DynamicResource Inset.None}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.None}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <Style x:Key="OptionsWindow.TextBlockBase"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FlowDirection" Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Language" Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="OptionsWindow.TitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OptionsWindow.TextBlockBase}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OptionsWindow.SectionTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OptionsWindow.TextBlockBase}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyStrong}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OptionsWindow.BodyText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OptionsWindow.TextBlockBase}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight" Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

                        <Style x:Key="OptionsWindow.TabText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OptionsWindow.TextBlockBase}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Body}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

                        <Style x:Key="OptionsWindow.TopTab"
                   TargetType="{x:Type RadioButton}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.None}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.10}" />
                <Setter Property="MinHeight"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Cursor"
                        Value="{x:Static Cursors.Hand}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource FluentFocusVisualStyle}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">
                                <Border x:Name="TabChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{DynamicResource Radius.None}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Viewbox Width="{DynamicResource Space.12}"
                                                 Height="{DynamicResource Space.12}"
                                                 Stretch="Uniform">
                                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Stretch="Uniform" />
                                        </Viewbox>

                                        <Border Width="{DynamicResource Space.8}" />

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SelectionIndicator"
                                        Width="{DynamicResource Space.24}"
                                        Height="{DynamicResource Space.2}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Brush.Accent.SelectedBorder}"
                                        CornerRadius="{DynamicResource Radius.None}"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        SnapsToDevicePixels="True" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver"
                                                   Value="True" />
                                        <Condition Property="IsChecked"
                                                   Value="False" />
                                        <Condition Property="IsEnabled"
                                                   Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Control.Fill.Hover}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Text.Primary}" />
                                </MultiTrigger>

                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Control.Fill.Pressed}" />
                                </Trigger>

                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Accent.Subtle}" />
                                    <Setter TargetName="SelectionIndicator"
                                            Property="Visibility"
                                            Value="Visible" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Accent.Text}" />
                                    <Setter Property="FontWeight"
                                            Value="{DynamicResource FontWeight.SemiBold}" />
                                </Trigger>

                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="TabChrome"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Transparent}" />
                                    <Setter TargetName="SelectionIndicator"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Text.Disabled}" />
                                    <Setter Property="Cursor"
                                            Value="{x:Static Cursors.Arrow}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="OptionsWindow.FooterPrimaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinWidth" Value="{DynamicResource Space.112}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.16.8}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="OptionsWindow.FooterSecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="{DynamicResource Space.112}" />
                <Setter Property="Padding" Value="{DynamicResource Inset.16.8}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.48}"
                            CornerRadius="{DynamicResource Radius.None}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Window.ResizeBorderThickness}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource OptionsWindow.RootFrame}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource OptionsWindow.TopBar}"
                    BorderThickness="{DynamicResource Inset.0.0.0.1}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                FlowDirection="{DynamicResource App.FlowDirection}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LocOptions_WindowTitle}"
                                   Style="{StaticResource OptionsWindow.TitleText}" />

                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="{DynamicResource Space.32}"
                            Height="{DynamicResource Space.32}"
                            MinWidth="{DynamicResource Space.32}"
                            Padding="{DynamicResource Inset.None}"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{StaticResource AppTip.OptionsWindow.1}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            Click="CancelButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="{DynamicResource Inset.8.All}"
                  MinHeight="0"
                  VerticalAlignment="Stretch"
                  FlowDirection="{DynamicResource App.FlowDirection}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Layer.Surface}"
                        BorderBrush="{DynamicResource Brush.Transparent}"
                        BorderThickness="{DynamicResource Inset.None}"
                        CornerRadius="{DynamicResource Radius.None}"
                        Padding="{DynamicResource Inset.8.All}"
                        SnapsToDevicePixels="True">

                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="ProcessingTabButton"
                                     Grid.Column="0"
                                     GroupName="OptionsTabs"
                                     IsChecked="True"
                                     Tag="{StaticResource Icon.Settings}"
                                     Style="{StaticResource OptionsWindow.TopTab}"
                                     Checked="OnTabButtonChecked">
                            <TextBlock Text="{DynamicResource LocOptions_TabProcessing}"
                                       Style="{StaticResource OptionsWindow.TabText}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       TextAlignment="Center" />
                        </RadioButton>

                        <RadioButton x:Name="PathsTabButton"
                                     Grid.Column="1"
                                     GroupName="OptionsTabs"
                                     Tag="{StaticResource Icon.Folder}"
                                     Style="{StaticResource OptionsWindow.TopTab}"
                                     Checked="OnTabButtonChecked">
                            <TextBlock Text="{DynamicResource LocOptions_TabPaths}"
                                       Style="{StaticResource OptionsWindow.TabText}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       TextAlignment="Center" />
                        </RadioButton>

                        <RadioButton x:Name="RedumpTabButton"
                                     Grid.Column="2"
                                     GroupName="OptionsTabs"
                                     Tag="{StaticResource Icon.DatabaseSearch}"
                                     Style="{StaticResource OptionsWindow.TopTab}"
                                     Checked="OnTabButtonChecked">
                            <TextBlock Text="{DynamicResource LocOptions_TabRedump}"
                                       Style="{StaticResource OptionsWindow.TabText}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       TextAlignment="Center" />
                        </RadioButton>

                        <RadioButton x:Name="PerformanceTabButton"
                                     Grid.Column="3"
                                     GroupName="OptionsTabs"
                                     Tag="{StaticResource Icon.Games}"
                                     Style="{StaticResource OptionsWindow.TopTab}"
                                     Checked="OnTabButtonChecked">
                            <TextBlock Text="{DynamicResource LocOptions_TabPerformance}"
                                       Style="{StaticResource OptionsWindow.TabText}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       TextAlignment="Center" />
                        </RadioButton>

                        <RadioButton x:Name="ExternalToolsTabButton"
                                     Grid.Column="4"
                                     GroupName="OptionsTabs"
                                     Tag="{StaticResource OptionsWindow.Icon.Extensions}"
                                     Style="{StaticResource OptionsWindow.TopTab}"
                                     Checked="OnTabButtonChecked">
                            <TextBlock Text="{DynamicResource LocOptions_TabAddons}"
                                       Style="{StaticResource OptionsWindow.TabText}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       TextAlignment="Center" />
                        </RadioButton>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource OptionsWindow.ContentPanel}"
                        MinHeight="0">

                    <Grid Background="{DynamicResource Brush.Transparent}"
                          MinHeight="0"
                          ClipToBounds="True"
                          FlowDirection="{DynamicResource App.FlowDirection}">

                        <options:PathsSettingsView x:Name="PathsPanel"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Visibility="Collapsed" />

                        <options:RedumpSettingsView x:Name="RedumpPanel"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Visibility="Collapsed" />

                        <options:ProcessingSettingsView x:Name="ProcessingPanel"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch" />

                        <options:ExternalToolsSettingsView x:Name="ExternalToolsPanel"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          Visibility="Collapsed" />

                        <options:PerformanceSettingsView x:Name="PerformancePanel"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2"
                    Style="{StaticResource Win11.DialogActionBar}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RestoreDefaultsButton"
                            Grid.Column="0"
                            Content="{DynamicResource LocOptions_RestoreDefaults}"
                            Style="{StaticResource OptionsWindow.FooterSecondaryButton}"
                            Click="RestoreDefaultsButton_Click" />

                    <Grid Grid.Column="2"
                          FlowDirection="{DynamicResource App.FlowDirection}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{DynamicResource LocCommon_Cancel}"
                                Style="{StaticResource OptionsWindow.FooterSecondaryButton}"
                                Click="CancelButton_Click" />

                        <Button Grid.Column="2"
                                Content="{DynamicResource LocCommon_Apply}"
                                Style="{StaticResource OptionsWindow.FooterSecondaryButton}"
                                Click="ApplyButton_Click"
                                IsEnabled="{Binding CanSave}" />

                        <Button Grid.Column="4"
                                Content="{DynamicResource LocCommon_Ok}"
                                Style="{StaticResource OptionsWindow.FooterPrimaryButton}"
                                Click="OkButton_Click"
                                IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
