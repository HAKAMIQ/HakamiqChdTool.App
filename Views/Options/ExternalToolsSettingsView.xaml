<UserControl x:Class="HakamiqChdTool.App.Views.Options.ExternalToolsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ExternalToolsCardTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ExternalToolsCardDescriptionText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.86" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Layer.Surface}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="{DynamicResource Inset.1.All}"
            CornerRadius="{DynamicResource Radius.Control}"
            Padding="{DynamicResource Inset.12.All}"
            HorizontalAlignment="Stretch"
            SnapsToDevicePixels="True">
        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.4}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Center"
                       Text="{DynamicResource LocExternalTools_Title}"
                       Style="{StaticResource ExternalToolsCardTitleText}"
                       TextWrapping="NoWrap" />

            <TextBlock Grid.Row="2"
                       HorizontalAlignment="Right"
                       Text="{DynamicResource LocExternalTools_CsoKitDescription}"
                       Style="{StaticResource ExternalToolsCardDescriptionText}"
                       TextWrapping="Wrap"
                       TextTrimming="None" />

            <Border Grid.Row="4"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.1.All}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="{DynamicResource Inset.12.All}"
                    ToolTip="{Binding ExternalToolsCsoKitPath}"
                    HorizontalAlignment="Stretch"
                    SnapsToDevicePixels="True">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{DynamicResource LocExternalTools_StatusLabel}"
                               Style="{StaticResource ExternalToolsCardTitleText}"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="|"
                               Style="{StaticResource ExternalToolsCardDescriptionText}"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="{Binding ExternalToolsCsoKitStatusText, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                               ToolTip="{Binding ExternalToolsCsoKitStatusText, Converter={StaticResource BidiTextConverter}, ConverterParameter=Ui}"
                               Style="{StaticResource ExternalToolsCardDescriptionText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="5"
                               VerticalAlignment="Center"
                               Text="{DynamicResource LocExternalTools_VersionLabel}"
                               Style="{StaticResource ExternalToolsCardTitleText}"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FlowDirection="LeftToRight"
                               Language="en-US"
                               TextAlignment="Left"
                               Text="{Binding ExternalToolsCsoKitVersion, Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               ToolTip="{Binding ExternalToolsCsoKitVersion, Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                               Style="{StaticResource ExternalToolsCardDescriptionText}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.1.All}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="{DynamicResource Inset.12.All}"
                    HorizontalAlignment="Stretch"
                    SnapsToDevicePixels="True">
                <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource LocExternalTools_SetupNoteTitle}"
                               Style="{StaticResource ExternalToolsCardTitleText}"
                               TextWrapping="NoWrap" />

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource LocExternalTools_SetupInstructions}"
                               Style="{StaticResource ExternalToolsCardDescriptionText}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                </Grid>
            </Border>

            <Grid Grid.Row="8"
                  HorizontalAlignment="Right"
                  FlowDirection="LeftToRight"
                  Language="{DynamicResource App.XmlLanguage}"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        MinWidth="116"
                        MinHeight="32"
                        Content="{DynamicResource LocExternalTools_Recheck}"
                        Click="RecheckButton_Click"
                        />

                <Button Grid.Column="2"
                        MinWidth="128"
                        MinHeight="32"
                        Content="{DynamicResource LocExternalTools_OpenFolder}"
                        Click="OpenToolsFolderButton_Click"
                        />
            </Grid>
        </Grid>
    </Border>
</UserControl>
