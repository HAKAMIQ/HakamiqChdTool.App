<UserControl x:Class="HakamiqChdTool.App.Views.Options.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ToolTip x:Key="AppTip.GenView.1"
                     x:Shared="False"
                     FlowDirection="{DynamicResource App.FlowDirection}"
                     Language="{DynamicResource App.XmlLanguage}"
                     Content="{DynamicResource LocGeneralSettings_LanguageDescription}">
                <ToolTip.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                                   MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                    </DataTemplate>
                </ToolTip.ContentTemplate>
            </ToolTip>

            <ToolTip x:Key="AppTip.GenView.2"
                     x:Shared="False"
                     FlowDirection="{DynamicResource App.FlowDirection}"
                     Language="{DynamicResource App.XmlLanguage}"
                     Content="{DynamicResource LocGeneralSettings_ThemeDescription}">
                <ToolTip.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                                   MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                    </DataTemplate>
                </ToolTip.ContentTemplate>
            </ToolTip>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <Border Style="{StaticResource Win11SettingsSection}">
                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Style="{StaticResource Win11SettingsSectionHeader}">
                            <TextBlock Style="{StaticResource Win11SettingsSectionTitleText}"
                                       Text="{DynamicResource LocGeneralSettings_AppearanceSection}"
                                       TextAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource Win11SettingsRow}">
                            <Grid Style="{StaticResource Win11SettingsRowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Style="{StaticResource Win11SettingsRowTextArea}">
                                    <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                               Text="{DynamicResource LocGeneralSettings_LanguageTitle}"
                                               ToolTip="{StaticResource AppTip.GenView.1}"
                                               TextAlignment="Left" />
                                </Grid>

                                <ComboBox x:Name="UiLanguageComboBox"
                                          Grid.Column="2"
                                          SelectedValue="{Binding UiLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource Win11SettingsComboBox}"
                                          ToolTip="{StaticResource AppTip.GenView.1}"
                                          AutomationProperties.Name="{DynamicResource LocGeneralSettings_LanguageTitle}">
                                    <ComboBoxItem Tag="ar-SA" Content="{DynamicResource LocLanguage_Arabic}" />

                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LocLanguage_English}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource Win11SettingsLastRow}">
                            <Grid Style="{StaticResource Win11SettingsRowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Style="{StaticResource Win11SettingsRowTextArea}">
                                    <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                               Text="{DynamicResource LocGeneralSettings_ThemeTitle}"
                                               ToolTip="{StaticResource AppTip.GenView.2}"
                                               TextAlignment="Left" />
                                </Grid>

                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="2"
                                          SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource Win11SettingsComboBox}"
                                          ToolTip="{StaticResource AppTip.GenView.2}"
                                          AutomationProperties.Name="{DynamicResource LocGeneralSettings_ThemeTitle}">
                                    <ComboBoxItem Tag="Light" Content="{DynamicResource LocUi_Theme_Light}" />

                                    <ComboBoxItem Tag="Dark" Content="{DynamicResource LocUi_Theme_Dark}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>