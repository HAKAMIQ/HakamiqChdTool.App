<UserControl x:Class="HakamiqChdTool.App.Views.Options.ProcessingSettingsView"
             x:Name="ProcessingSettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:HakamiqChdTool.App.Views.Options"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <opt:OptSection Header="{DynamicResource LocConversion_EngineSection}">
                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocPaths_UseBundledChdman}"
                                Description="{DynamicResource LocPaths_UseBundledChdmanDesc}">
                        <RadioButton x:Name="UseBundledChdmanRadioButton"
                                     GroupName="ChdmanSource"
                                     IsChecked="{Binding UseBundledChdman, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Win11SettingsRadioButton}"
                                     AutomationProperties.Name="{DynamicResource LocPaths_UseBundledChdman}" />
                    </opt:OptRow>

                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocPaths_UseExternalChdman}"
                                Description="{DynamicResource LocPaths_UseExternalChdmanDesc}">
                        <RadioButton x:Name="UseExternalChdmanRadioButton"
                                     GroupName="ChdmanSource"
                                     IsChecked="{Binding UseExternalChdman, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Win11SettingsRadioButton}"
                                     AutomationProperties.Name="{DynamicResource LocPaths_UseExternalChdman}" />
                        <opt:OptRow.Extra>
                            <!-- The path box appears once the external copy is chosen. -->
                            <Grid Visibility="{Binding UseExternalChdman, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExternalChdmanPathTextBox"
                                         Height="{DynamicResource Space.32}"
                                         Text="{Binding ExternalChdmanPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         FlowDirection="LeftToRight"
                                         Language="en-US"
                                         TextAlignment="Left"
                                         Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                         AutomationProperties.Name="{DynamicResource LocPaths_ExternalChdmanPath}" />
                                <Button x:Name="BrowseExternalChdmanButton"
                                        Grid.Column="1"
                                        Command="{Binding BrowseExternalChdmanCommand}"
                                        Style="{StaticResource OptPathButton}"
                                        AutomationProperties.Name="{DynamicResource LocPaths_ExternalChdmanPath}"
                                        Content="{DynamicResource LocCommon_Browse}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource OptFieldError}" Text="{Binding ExternalChdmanPathError}" />
                            </Grid>
                        </opt:OptRow.Extra>
                    </opt:OptRow>
                </opt:OptSection>

                <opt:OptSection Header="{DynamicResource LocConversion_ChdSection}">
                    <!-- First, because it can override the hunk size and the compression below. -->
                    <opt:OptRow Title="{DynamicResource LocPerformance_TargetEmulator}"
                                Description="{Binding TargetEmulatorDescription}">
                        <ComboBox x:Name="TargetEmulatorComboBox"
                                  ItemsSource="{Binding TargetEmulatorOptions}"
                                  SelectedItem="{Binding SelectedTargetEmulator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Label"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocPerformance_TargetEmulator}" />
                    </opt:OptRow>

                    <opt:OptRow Title="{DynamicResource LocPerformance_CompressionPreset}"
                                Description="{Binding CompressionPresetDescription}">
                        <ComboBox x:Name="CompressionPresetComboBox"
                                  ItemsSource="{Binding CompressionPresetOptions}"
                                  SelectedItem="{Binding SelectedCompressionPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Label"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocPerformance_CompressionPreset}" />
                    </opt:OptRow>

                    <opt:OptRow x:Name="HunkPresetRow"
                                IsEnabled="{Binding CanChooseHunkSize}"
                                Title="{DynamicResource LocPerformance_HunkSize}"
                                Description="{Binding HunkPresetDescription}">
                        <ComboBox x:Name="HunkPresetComboBox"
                                  ItemsSource="{Binding HunkPresetOptions}"
                                  SelectedItem="{Binding SelectedHunkPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Label"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocPerformance_HunkSize}" />
                    </opt:OptRow>

                    <opt:OptRow Title="{DynamicResource LocPerformance_IsoCreateMode}"
                                Description="{Binding IsoCreateOverrideDescription}">
                        <ComboBox x:Name="IsoCreateCommandOverrideComboBox"
                                  ItemsSource="{Binding IsoCreateOverrideOptions}"
                                  SelectedItem="{Binding SelectedIsoCreateOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Label"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocPerformance_IsoCreateMode}" />
                    </opt:OptRow>

                    <opt:OptRow Title="{DynamicResource LocPerformance_ChdPlatformProfile}"
                                Description="{Binding ChdPlatformProfileDescription}">
                        <ComboBox x:Name="ChdPlatformProfileComboBox"
                                  ItemsSource="{Binding ChdPlatformProfileOptions}"
                                  SelectedItem="{Binding SelectedChdPlatformProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Label"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocPerformance_ChdPlatformProfile}" />
                    </opt:OptRow>
                </opt:OptSection>

                <opt:OptSection Header="{DynamicResource LocConversion_ExtractSection}">
                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocConversion_ExtractGdRomAsCueBin}"
                                Description="{DynamicResource LocConversion_ExtractGdRomAsCueBinDesc}">
                        <CheckBox x:Name="ExtractGdRomAsCueBinCheckBox"
                                  IsChecked="{Binding ExtractGdRomAsCueBin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocConversion_ExtractGdRomAsCueBin}" />
                    </opt:OptRow>
                </opt:OptSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
