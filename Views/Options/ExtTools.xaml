<UserControl x:Class="HakamiqChdTool.App.Views.Options.ExternalToolsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <Border Style="{StaticResource Win11SettingsSection}">
                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True">

                        <Grid.Resources>
                            <SolidColorBrush x:Key="CsoSuccessBrush"
                                             Color="{DynamicResource Fluent.Status.Success.Foreground1}" />

                            <SolidColorBrush x:Key="CsoDangerBrush"
                                             Color="{DynamicResource Fluent.Status.Danger.Foreground1}" />
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Hakamiq-CsoKit 0.6.1 -->
                        <Grid Grid.Row="0"
                              Height="{DynamicResource Space.32}"
                              Style="{StaticResource Win11SettingsSectionHeader}">

                            <StackPanel Orientation="Horizontal"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{DynamicResource LocExternalTools_Title}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           FontWeight="{DynamicResource FontWeight.SemiBold}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />

                                <TextBlock Width="{DynamicResource Space.6}"
                                           Visibility="{Binding ExternalToolsCsoKitIsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock Text="{Binding ExternalToolsCsoKitVersion}"
                                           Visibility="{Binding ExternalToolsCsoKitIsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource FontWeight.SemiBold}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FlowDirection="LeftToRight"
                                           Language="en-US"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource Win11SettingsLastRow}"
                                Padding="{DynamicResource Inset.6.All}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- المسار -->
                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LocExternalTools_PathLabel}"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource FontWeight.SemiBold}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />

                                    <Border Grid.Column="2"
                                            Height="{DynamicResource Space.32}"
                                            Background="{DynamicResource Brush.Layer.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="{DynamicResource Inset.1.All}"
                                            CornerRadius="{DynamicResource Radius.Control}"
                                            Padding="{DynamicResource Inset.8.4}">

                                        <TextBlock Text="{Binding ExternalToolsCsoKitPath}"
                                                   ToolTip="{Binding ExternalToolsCsoKitPath}"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   FlowDirection="LeftToRight"
                                                   Language="en-US"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Button x:Name="BrowseCsoKitToolButton"
                                            Grid.Column="4"
                                            Width="{DynamicResource Space.80}"
                                            Height="{DynamicResource Space.32}"
                                            Click="BrowseCsoKitToolButton_Click"
                                            AutomationProperties.Name="{DynamicResource LocExternalTools_Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}">

                                        <TextBlock Text="{DynamicResource LocExternalTools_Browse}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Button>
                                </Grid>

                                <!-- تعليمات تظهر فقط عند فقد الأداة -->
                                <Grid Grid.Row="2"
                                      Visibility="{Binding ExternalToolsCsoKitShowSetupNote, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource LocExternalTools_SetupNoteTitle}"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource FontWeight.SemiBold}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LocExternalTools_SetupInstructions}"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <!-- الحالة يمين + الأزرار يسار -->
                                <Grid Grid.Row="4"
                                      FlowDirection="LeftToRight">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- الأزرار في اليسار -->
                                    <Grid Grid.Column="0"
                                          HorizontalAlignment="Left">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{DynamicResource Grid.Space.128}" />
                                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                            <ColumnDefinition Width="{DynamicResource Grid.Space.128}" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="RecheckButton"
                                                Grid.Column="0"
                                                Width="{DynamicResource Space.128}"
                                                Height="{DynamicResource Space.32}"
                                                Click="RecheckButton_Click"
                                                AutomationProperties.Name="{DynamicResource LocExternalTools_Recheck}"
                                                Style="{StaticResource SecondaryButtonStyle}">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Path Width="{DynamicResource Space.12}"
                                                      Height="{DynamicResource Space.12}"
                                                      Margin="{DynamicResource Inset.0.0.6.0}"
                                                      Data="{StaticResource Icon.Queue.Retry}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform" />

                                                <TextBlock Text="{DynamicResource LocExternalTools_Recheck}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="OpenToolsFolderButton"
                                                Grid.Column="2"
                                                Width="{DynamicResource Space.128}"
                                                Height="{DynamicResource Space.32}"
                                                Click="OpenToolsFolderButton_Click"
                                                AutomationProperties.Name="{DynamicResource LocExternalTools_OpenFolder}"
                                                Style="{StaticResource SecondaryButtonStyle}">

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Path Width="{DynamicResource Space.12}"
                                                      Height="{DynamicResource Space.12}"
                                                      Margin="{DynamicResource Inset.0.0.6.0}"
                                                      Data="{StaticResource Icon.FolderOpen}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Stretch="Uniform" />

                                                <TextBlock Text="{DynamicResource LocExternalTools_OpenFolder}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- الحالة في أقصى اليمين -->
                                    <Grid Grid.Column="2"
                                          FlowDirection="{DynamicResource App.FlowDirection}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{DynamicResource Grid.Space.6}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="{DynamicResource Space.8}"
                                                 Height="{DynamicResource Space.8}"
                                                 VerticalAlignment="Center">

                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource Brush.Text.Secondary}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExternalToolsCsoKitIsAvailable}"
                                                                     Value="True">

                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource CsoSuccessBrush}" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding ExternalToolsCsoKitShowSetupNote}"
                                                                     Value="True">

                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource CsoDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ExternalToolsCsoKitStatusText}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource FontWeight.SemiBold}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap">

                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Brush.Text.Secondary}" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExternalToolsCsoKitIsAvailable}"
                                                                     Value="True">

                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource CsoSuccessBrush}" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding ExternalToolsCsoKitShowSetupNote}"
                                                                     Value="True">

                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource CsoDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- عند الخطأ يظهر المسار بعد الحالة -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ExternalToolsCsoKitPath}"
                                                   ToolTip="{Binding ExternalToolsCsoKitPath}"
                                                   Visibility="{Binding ExternalToolsCsoKitShowSetupNote, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   MaxWidth="260"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{DynamicResource CsoDangerBrush}"
                                                   FlowDirection="LeftToRight"
                                                   Language="en-US"
                                                   TextAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>