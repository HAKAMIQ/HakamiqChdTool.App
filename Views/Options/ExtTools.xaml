<UserControl x:Class="HakamiqChdTool.App.Views.Options.ExternalToolsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:HakamiqChdTool.App.Views.Options"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ToolSuccessBrush" Color="{DynamicResource Fluent.Status.Success.Foreground1}" />
            <SolidColorBrush x:Key="ToolDangerBrush" Color="{DynamicResource Fluent.Status.Danger.Foreground1}" />

            <!-- Green when the tool is ready, red when it needs attention, grey while checking. -->
            <Style x:Key="ToolStateText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight" Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <!-- Shipped with the app and checked against their pinned SHA-256 before every run. -->
                <opt:OptSection x:Name="BundledToolsSection"
                                Header="{DynamicResource LocTools_BundledSection}"
                                ItemsSource="{Binding BundledTools}">
                    <opt:OptSection.ItemTemplate>
                        <DataTemplate>
                            <opt:OptRow Title="{Binding Title}"
                                        Description="{Binding Purpose}">
                                <TextBlock Text="{Binding StateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ToolStateText}">
                                            <Setter Property="Foreground" Value="{DynamicResource ToolDangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ToolSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </opt:OptRow>
                        </DataTemplate>
                    </opt:OptSection.ItemTemplate>
                </opt:OptSection>

                <!-- Tools that can be replaced by a copy you choose. -->
                <opt:OptSection Header="{DynamicResource LocTools_ReplaceableSection}">
                    <opt:OptRow Title="{DynamicResource LocExternalTools_Title}"
                                Description="{DynamicResource LocExternalTools_CsoKitDescription}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExternalToolsCsoKitStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ToolStateText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExternalToolsCsoKitIsAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ToolSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ExternalToolsCsoKitShowSetupNote}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ToolDangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExternalToolsCsoKitVersion}"
                                       Visibility="{Binding ExternalToolsCsoKitIsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="{DynamicResource Inset.8.0.0.0}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FlowDirection="LeftToRight"
                                       Language="en-US"
                                       NumberSubstitution.Substitution="European"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <opt:OptRow.Extra>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Height="{DynamicResource Space.32}"
                                             IsReadOnly="True"
                                             Text="{Binding ExternalToolsCsoKitPath, Mode=OneWay}"
                                             ToolTip="{Binding ExternalToolsCsoKitPath}"
                                             FlowDirection="LeftToRight"
                                             TextAlignment="Left"
                                             Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                             AutomationProperties.Name="{DynamicResource LocExternalTools_PathLabel}" />
                                    <Button x:Name="BrowseCsoKitToolButton"
                                            Grid.Column="1"
                                            Click="BrowseCsoKitToolButton_Click"
                                            Style="{StaticResource OptPathButton}"
                                            AutomationProperties.Name="{DynamicResource LocExternalTools_Browse}"
                                            Content="{DynamicResource LocExternalTools_Browse}" />
                                    <!-- Shown only while a chosen copy replaces the bundled one. -->
                                    <Button x:Name="UseBundledCsoKitButton"
                                            Grid.Column="2"
                                            Click="UseBundledCsoKitButton_Click"
                                            Visibility="{Binding ExternalCsoKitPath, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                            Style="{StaticResource OptPathButton}"
                                            AutomationProperties.Name="{DynamicResource LocTools_UseBundled}"
                                            Content="{DynamicResource LocTools_UseBundled}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource LocExternalTools_SetupInstructions}"
                                           Visibility="{Binding ExternalToolsCsoKitShowSetupNote, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Margin="{DynamicResource Inset.0.8.0.0}"
                                           Style="{StaticResource Win11SettingsRowDescriptionText}"
                                           TextTrimming="None" />
                            </StackPanel>
                        </opt:OptRow.Extra>
                    </opt:OptRow>

                    <opt:OptRow Title="igir"
                                Description="{DynamicResource LocExternalTools_IgirDescription}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExternalToolsIgirStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ToolStateText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExternalToolsIgirIsAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ToolSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- The version is hidden when igir is unavailable, so "unavailable" is not shown twice. -->
                            <TextBlock Text="{Binding ExternalToolsIgirVersion}" Visibility="{Binding ExternalToolsIgirIsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="{DynamicResource Inset.8.0.0.0}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FlowDirection="LeftToRight"
                                       Language="en-US"
                                       NumberSubstitution.Substitution="European"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <opt:OptRow.Extra>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Height="{DynamicResource Space.32}"
                                         IsReadOnly="True"
                                         Text="{Binding ExternalToolsIgirPath, Mode=OneWay}"
                                         ToolTip="{Binding ExternalToolsIgirPath}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Left"
                                         Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                         AutomationProperties.Name="{DynamicResource LocExternalTools_PathLabel}" />
                                <Button x:Name="BrowseIgirToolButton"
                                        Grid.Column="1"
                                        Click="BrowseIgirToolButton_Click"
                                        Style="{StaticResource OptPathButton}"
                                        AutomationProperties.Name="{DynamicResource LocExternalTools_Browse}"
                                        Content="{DynamicResource LocExternalTools_Browse}" />
                                <Button x:Name="UseBundledIgirButton"
                                        Grid.Column="2"
                                        Click="UseBundledIgirButton_Click"
                                        Visibility="{Binding ExternalIgirPath, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                        Style="{StaticResource OptPathButton}"
                                        AutomationProperties.Name="{DynamicResource LocTools_UseBundled}"
                                        Content="{DynamicResource LocTools_UseBundled}" />
                            </Grid>
                        </opt:OptRow.Extra>
                    </opt:OptRow>
                </opt:OptSection>

                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Inset.0.0.0.8}">
                    <Button x:Name="RecheckButton"
                            MinWidth="{DynamicResource Space.128}"
                            Height="{DynamicResource Space.32}"
                            Click="RecheckButton_Click"
                            AutomationProperties.Name="{DynamicResource LocExternalTools_Recheck}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="{DynamicResource Space.12}"
                                  Height="{DynamicResource Space.12}"
                                  Margin="{DynamicResource Inset.0.0.6.0}"
                                  Data="{StaticResource Icon.Queue.Retry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                            <TextBlock Text="{DynamicResource LocExternalTools_Recheck}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenToolsFolderButton"
                            MinWidth="{DynamicResource Space.128}"
                            Height="{DynamicResource Space.32}"
                            Margin="{DynamicResource Inset.8.0.0.0}"
                            Click="OpenToolsFolderButton_Click"
                            AutomationProperties.Name="{DynamicResource LocExternalTools_OpenFolder}"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="{DynamicResource Space.12}"
                                  Height="{DynamicResource Space.12}"
                                  Margin="{DynamicResource Inset.0.0.6.0}"
                                  Data="{StaticResource Icon.FolderOpen}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                            <TextBlock Text="{DynamicResource LocExternalTools_OpenFolder}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
