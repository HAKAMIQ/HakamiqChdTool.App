<UserControl x:Class="HakamiqChdTool.App.Views.Options.RedumpSettingsView"
             x:Name="RedumpSettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:HakamiqChdTool.App.Views.Options"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="RedumpSuccessBrush"
                             Color="{DynamicResource Fluent.Status.Success.Foreground1}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <opt:OptSection Header="{DynamicResource LocRedump_Tool_Title}">
                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocRedumpSettings_ShowInMainTitle}"
                                Description="{DynamicResource LocRedumpSettings_ShowInMainDesc}">
                        <CheckBox x:Name="EnableDeepIntegrityCheckCheckBox"
                                  IsChecked="{Binding EnableDeepIntegrityCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocRedumpSettings_ShowInMainTitle}" />
                    </opt:OptRow>

                    <opt:OptRow Placement="Leading"
                                Visibility="{Binding EnableDeepIntegrityCheck, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Title="{DynamicResource LocRedumpSettings_SuggestNameTitle}"
                                Description="{DynamicResource LocRedumpSettings_SuggestNameDesc}">
                        <CheckBox x:Name="ApplyStandardNamingBasedOnHashCheckBox"
                                  IsChecked="{Binding ApplyStandardNamingBasedOnHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocRedumpSettings_SuggestNameTitle}" />
                    </opt:OptRow>
                </opt:OptSection>

                <!-- The database: its state, the DAT folder it is built from, and a single DAT import. -->
                <opt:OptSection Header="{DynamicResource LocRedumpSettings_LocalImportSection}"
                                Visibility="{Binding EnableDeepIntegrityCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <opt:OptRow Title="{DynamicResource LocRedumpSettings_LocalStatusTitle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DatabaseStatusTextBlock"
                                       Text="{Binding DatabaseStatusText}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       FontWeight="{DynamicResource FontWeight.SemiBold}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDatabaseAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource RedumpSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource LocAdv_DatabaseLastSyncedPrefix}"
                                       Margin="{DynamicResource Inset.12.0.0.0}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock x:Name="DatabaseLastSyncedTextBlock"
                                       Text="{Binding DatabaseLastSyncedDisplay}"
                                       Margin="{DynamicResource Inset.4.0}"
                                       FlowDirection="LeftToRight"
                                       Language="en-US"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </opt:OptRow>

                    <opt:OptRow Title="{DynamicResource LocRedumpSettings_LocalFolderTitle}"
                                Description="{DynamicResource LocRedumpSettings_LocalFolderDesc}">
                        <opt:OptRow.Extra>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="RedumpLocalFolderTextBox"
                                         Height="{DynamicResource Space.32}"
                                         Text="{Binding RedumpLocalLibraryRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         FlowDirection="LeftToRight"
                                         Language="en-US"
                                         TextAlignment="Left"
                                         Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                         ToolTip="{Binding RedumpLocalLibraryRoot}"
                                         AutomationProperties.Name="{DynamicResource LocRedumpSettings_LocalFolderTitle}" />
                                <Button Grid.Column="1"
                                        Command="{Binding BrowseRedumpLocalLibraryCommand}"
                                        Style="{StaticResource OptPathButton}"
                                        AutomationProperties.Name="{DynamicResource LocRedumpSettings_BrowseLocalFolderButton}"
                                        Content="{DynamicResource LocRedumpSettings_BrowseLocalFolderButton}" />

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource OptFieldError}" Text="{Binding RedumpLocalFolderError}" />

                                <!-- Scan only counts what is there; Prepare also imports it into the database. -->
                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Margin="{DynamicResource Inset.0.8.0.0}">
                                    <Button Command="{Binding ImportRedumpLocalLibraryCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="{DynamicResource Space.128}"
                                            Height="{DynamicResource Space.32}"
                                            ToolTip="{DynamicResource LocRedumpSettings_PrepareLocalLibraryTooltip}"
                                            AutomationProperties.Name="{DynamicResource LocRedumpSettings_PrepareLocalLibraryButton}"
                                            Content="{DynamicResource LocRedumpSettings_PrepareLocalLibraryButton}" />
                                    <Button Command="{Binding ScanRedumpLocalLibraryCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="{DynamicResource Space.128}"
                                            Height="{DynamicResource Space.32}"
                                            Margin="{DynamicResource Inset.8.0.0.0}"
                                            ToolTip="{DynamicResource LocRedumpSettings_ScanLocalFolderTooltip}"
                                            AutomationProperties.Name="{DynamicResource LocRedumpSettings_ScanLocalFolderButton}"
                                            Content="{DynamicResource LocRedumpSettings_ScanLocalFolderButton}" />
                                </StackPanel>

                                <!-- Result of Scan or Prepare. -->
                                <TextBlock x:Name="RedumpLocalScanSummaryTextBlock"
                                           Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Margin="{DynamicResource Inset.0.8.0.0}"
                                           Text="{Binding RedumpLocalLibraryScanSummary}"
                                           Visibility="{Binding RedumpLocalLibraryScanSummary, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                        </opt:OptRow.Extra>
                    </opt:OptRow>

                    <!-- One DAT or XML file; the button asks for the file. -->
                    <opt:OptRow Title="{DynamicResource LocRedumpSettings_DatFileTitle}"
                                Description="{DynamicResource LocRedumpSettings_DatFileDesc}">
                        <Button x:Name="ImportRedumpDatabaseButton"
                                Click="ImportRedumpDatabaseButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="{DynamicResource Space.96}"
                                Height="{DynamicResource Space.32}"
                                ToolTip="{DynamicResource LocRedumpSettings_ImportButtonTooltip}"
                                AutomationProperties.Name="{DynamicResource LocRedumpSettings_ImportButton}"
                                Content="{DynamicResource LocRedumpSettings_ImportButton}" />
                        <opt:OptRow.Extra>
                            <StackPanel>
                                <ProgressBar x:Name="RedumpImportProgressBar"
                                             Visibility="Collapsed"
                                             Height="{DynamicResource Space.4}"
                                             Maximum="100"
                                             FlowDirection="LeftToRight"
                                             Style="{StaticResource FluentQueueCardProgressBar}" />
                                <TextBlock x:Name="RedumpImportStatusTextBlock"
                                           Visibility="Collapsed"
                                           Margin="{DynamicResource Inset.0.4.0.0}"
                                           Style="{StaticResource Win11SettingsRowDescriptionText}"
                                           TextTrimming="None" />
                            </StackPanel>
                        </opt:OptRow.Extra>
                    </opt:OptRow>
                </opt:OptSection>

                <TextBlock x:Name="RedumpComplianceNoticeTextBlock"
                           Text="{DynamicResource LocRedumpSettings_ComplianceNotice}"
                           Style="{StaticResource Win11SettingsRowDescriptionText}"
                           Margin="{DynamicResource Inset.0.0.0.8}"
                           TextTrimming="None" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
