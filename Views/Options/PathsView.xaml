    </UserControl.Resources>

    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">



                                <Border Style="{StaticResource Win11SettingsSection}" Margin="{DynamicResource Inset.0.0.0.8}">
                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                                                                              Style="{StaticResource Win11SettingsSectionHeader}" MinHeight="{DynamicResource Space.32}">
                                                                            <TextBlock Style="{StaticResource Win11SettingsSectionTitleText}"
                                                                                       Text="{DynamicResource LocFiles_OrganizeSection}"
                                                                                       TextAlignment="Center" Margin="{DynamicResource Inset.8.4}"/>
                                                                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource Win11SettingsRow}"
                                Padding="{DynamicResource Inset.8.4}"
                                MinHeight="{DynamicResource Space.36}">
                            <Grid Style="{StaticResource Win11SettingsRowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="2"
                                      Style="{StaticResource Win11SettingsRowTextArea}">
                                    <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                               Text="{DynamicResource LocPaths_IncludeSubfolders}"
                                               ToolTip="{StaticResource AppTip.PathsView.1}"
                                               TextAlignment="Left" />
                                </Grid>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IncludeSubfolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Win11SettingsCheckBox}"
                                          ToolTip="{StaticResource AppTip.PathsView.1}"
                                          AutomationProperties.Name="{DynamicResource LocPaths_IncludeSubfolders}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource Win11SettingsLastRow}"
                                Padding="{DynamicResource Inset.8.4}"
                                MinHeight="{DynamicResource Space.36}">
                            <Grid SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Style="{StaticResource Win11SettingsRowGrid}" Grid.Column="0">
                                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                                            <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                                            <ColumnDefinition Width="*" />
                                                                                                                        </Grid.ColumnDefinitions>

                                                                                                                        <Grid Grid.Column="2"
                                                                                                                              Style="{StaticResource Win11SettingsRowTextArea}">
                                                                                                                            <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                                                                                                                       Text="{DynamicResource LocPaths_OrganizeByPlatform}"
                                                                                                                                       ToolTip="{StaticResource AppTip.PathsView.2}"
                                                                                                                                       TextAlignment="Left" />
                                                                                                                        </Grid>

                                                                                                                        <CheckBox x:Name="OrganizeByPlatformCheckBox"
                                                                                                                                  Grid.Column="0"
                                                                                                                                  IsChecked="{Binding OrganizeByPlatform, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                                  Style="{StaticResource Win11SettingsCheckBox}"
                                                                                                                                  ToolTip="{StaticResource AppTip.PathsView.2}"
                                                                                                                                  AutomationProperties.Name="{DynamicResource LocPaths_OrganizeByPlatform}" />
                                                                                                                    </Grid>

                                <Grid Style="{StaticResource Win11SettingsRowGrid}" Grid.Column="2">
                                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                                            <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                                            <ColumnDefinition Width="*" />
                                                                                                                        </Grid.ColumnDefinitions>

                                                                                                                        <Grid Grid.Column="2"
                                                                                                                              Style="{StaticResource Win11SettingsRowTextArea}">
                                                                                                                            <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                                                                                                                       Text="{DynamicResource LocPaths_OrganizeByRegion}"
                                                                                                                                       ToolTip="{StaticResource AppTip.PathsView.3}"
                                                                                                                                       TextAlignment="Left" />
                                                                                                                        </Grid>

                                                                                                                        <CheckBox Grid.Column="0"
                                                                                                                                  IsChecked="{Binding OrganizeByRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                                  Style="{StaticResource Win11SettingsCheckBox}"
                                                                                                                                  ToolTip="{StaticResource AppTip.PathsView.3}"
                                                                                                                                  AutomationProperties.Name="{DynamicResource LocPaths_OrganizeByRegion}" />
                                                                                                                    </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

<Border Style="{StaticResource Win11SettingsSection}" Margin="{DynamicResource Inset.0.0.0.8}">
                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True"
                          Grid.IsSharedSizeScope="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Style="{StaticResource Win11SettingsSectionHeader}"
                              MinHeight="{DynamicResource Space.32}">
                            <TextBlock Style="{StaticResource Win11SettingsSectionTitleText}"
                                       Text="{DynamicResource LocFiles_OutputSection}"
                                       TextAlignment="Center"
                                       Margin="{DynamicResource Inset.8.4}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Style="{StaticResource Win11SettingsRow}"
                                Padding="{DynamicResource Inset.8.4}"
                                MinHeight="{DynamicResource Space.36}">
                            <Grid Style="{StaticResource Win11SettingsRowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="Auto"
                                                      SharedSizeGroup="PathOptionLabel" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="UseCustomOutputRootCheckBox"
                                          Grid.Column="0"
                                          IsChecked="{Binding UseCustomOutputRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Win11SettingsCheckBox}"
                                          ToolTip="{StaticResource AppTip.PathsView.4}"
                                          AutomationProperties.Name="{DynamicResource LocPaths_CustomOutput}" />

                                <Grid Grid.Column="2"
                                      Style="{StaticResource Win11SettingsRowTextArea}">
                                    <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                               Text="{DynamicResource LocPaths_CustomOutput}"
                                               ToolTip="{StaticResource AppTip.PathsView.4}"
                                               TextAlignment="Left" />
                                </Grid>

                                <Grid Grid.Column="4"
                                      FlowDirection="{DynamicResource App.FlowDirection}"
                                      Language="{DynamicResource App.XmlLanguage}"
                                      VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseCustomOutputRoot}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="CustomOutputRootTextBox"
                                             Grid.Column="0"
                                             Height="{DynamicResource Space.32}"
                                             MinHeight="{DynamicResource Space.32}"
                                             Text="{Binding CustomOutputRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             IsEnabled="{Binding UseCustomOutputRoot}"
                                             FlowDirection="LeftToRight"
                                             Language="en-US"
                                             TextAlignment="Left"
                                             Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                             AutomationProperties.Name="{DynamicResource LocPaths_OutputFolder}">
                                        <TextBox.ToolTip>
                                            <TextBlock Text="{Binding CustomOutputRoot}"
                                                       FlowDirection="LeftToRight"
                                                       Language="en-US"
                                                       TextAlignment="Left"
                                                       TextWrapping="NoWrap" />
                                        </TextBox.ToolTip>
                                    </TextBox>

                                    <Button x:Name="BrowseOutputFolderButton"
                                            Grid.Column="2"
                                            Height="{DynamicResource Space.36}"
                                            MinHeight="{DynamicResource Space.32}"
                                            MinWidth="{DynamicResource Space.96}"
                                            Padding="{DynamicResource Inset.10.5}"
                                            Command="{Binding BrowseOutputFolderCommand}"
                                            IsEnabled="{Binding UseCustomOutputRoot}"
                                            Style="{StaticResource Win11SettingsCompactButton}"
                                            ToolTip="{StaticResource AppTip.PathsView.5}"
                                            AutomationProperties.Name="{DynamicResource LocPaths_OutputFolder}">
                                        <TextBlock Text="{DynamicResource LocCommon_Browse}"
                                                   TextAlignment="Left" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource Win11SettingsRow}"
                                Padding="{DynamicResource Inset.8.4}"
                                MinHeight="{DynamicResource Space.36}">
                            <Grid Style="{StaticResource Win11SettingsRowGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="Auto"
                                                      SharedSizeGroup="PathOptionLabel" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding UseCustomPendingWorkspace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Win11SettingsCheckBox}"
                                          ToolTip="{StaticResource AppTip.PathsView.6}"
                                          AutomationProperties.Name="{DynamicResource LocPaths_CustomTempFolder}" />

                                <Grid Grid.Column="2"
                                      Style="{StaticResource Win11SettingsRowTextArea}">
                                    <TextBlock Style="{StaticResource Win11SettingsRowTitleText}"
                                               Text="{DynamicResource LocPaths_CustomTempFolder}"
                                               ToolTip="{StaticResource AppTip.PathsView.6}"
                                               TextAlignment="Left" />
                                </Grid>

                                <Grid Grid.Column="4"
                                      FlowDirection="{DynamicResource App.FlowDirection}"
                                      Language="{DynamicResource App.XmlLanguage}"
                                      VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseCustomPendingWorkspace}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PendingWorkspaceCustomRootTextBox"
                                             Grid.Column="0"
                                             Height="{DynamicResource Space.32}"
                                             MinHeight="{DynamicResource Space.32}"
                                             Text="{Binding PendingWorkspaceCustomRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             IsEnabled="{Binding UseCustomPendingWorkspace}"
                                             FlowDirection="LeftToRight"
                                             Language="en-US"
                                             TextAlignment="Left"
                                             Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                             AutomationProperties.Name="{DynamicResource LocPaths_TempFolder}">
                                        <TextBox.ToolTip>
                                            <TextBlock Text="{Binding PendingWorkspaceCustomRoot}"
                                                       FlowDirection="LeftToRight"
                                                       Language="en-US"
                                                       TextAlignment="Left"
                                                       TextWrapping="NoWrap" />
                                        </TextBox.ToolTip>
                                    </TextBox>

                                    <Button x:Name="BrowsePendingWorkspaceButton"
                                            Grid.Column="2"
