<UserControl x:Class="HakamiqChdTool.App.Views.Options.PathsSettingsView"
             x:Name="PathsSettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:HakamiqChdTool.App.Views.Options"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- General: the options most people change. -->
    <Border Style="{StaticResource Win11SettingsPageRoot}">
        <ScrollViewer Style="{StaticResource Win11SettingsScrollViewer}">
            <StackPanel Style="{StaticResource Win11SettingsContentStack}">

                <opt:OptSection Header="{DynamicResource LocOpt_AddAndSaveSection}">
                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocPaths_IncludeSubfolders}"
                                Description="{DynamicResource LocPaths_IncludeSubfoldersDesc}">
                        <CheckBox x:Name="IncludeSubfoldersCheckBox"
                                  IsChecked="{Binding IncludeSubfolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocPaths_IncludeSubfolders}" />
                    </opt:OptRow>

                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocPaths_CustomOutput}"
                                Description="{DynamicResource LocPaths_CustomOutputDesc}">
                        <CheckBox x:Name="UseCustomOutputRootCheckBox"
                                  IsChecked="{Binding UseCustomOutputRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocPaths_CustomOutput}" />
                        <opt:OptRow.Extra>
                            <Grid Visibility="{Binding UseCustomOutputRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomOutputRootTextBox"
                                         Height="{DynamicResource Space.32}"
                                         Text="{Binding CustomOutputRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         FlowDirection="LeftToRight"
                                         Language="en-US"
                                         TextAlignment="Left"
                                         Style="{StaticResource Win11SettingsTechnicalTextBox}"
                                         ToolTip="{Binding CustomOutputRoot}"
                                         AutomationProperties.Name="{DynamicResource LocPaths_OutputFolder}" />
                                <Button x:Name="BrowseOutputFolderButton"
                                        Grid.Column="1"
                                        Command="{Binding BrowseOutputFolderCommand}"
                                        Style="{StaticResource OptPathButton}"
                                        AutomationProperties.Name="{DynamicResource LocPaths_OutputFolder}"
                                        Content="{DynamicResource LocCommon_Browse}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource OptFieldError}" Text="{Binding CustomOutputRootError}" />
                            </Grid>
                        </opt:OptRow.Extra>
                    </opt:OptRow>

                    <!-- One list for the two folder options (platform, region). -->
                    <opt:OptRow Title="{DynamicResource LocOpt_OrganizeTitle}"
                                Description="{Binding SelectedOutputOrganize.Description}">
                        <ComboBox x:Name="OutputOrganizeComboBox"
                                  ItemsSource="{Binding OutputOrganizeOptions}"
                                  SelectedItem="{Binding SelectedOutputOrganize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocOpt_OrganizeTitle}" />
                    </opt:OptRow>

                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocProcessing_SkipExistingOutput}"
                                Description="{DynamicResource LocProcessing_SkipExistingOutputDesc}">
                        <CheckBox x:Name="SkipExistingOutputCheckBox"
                                  IsChecked="{Binding SkipExistingOutput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocProcessing_SkipExistingOutput}" />
                    </opt:OptRow>
                </opt:OptSection>

                <opt:OptSection Header="{DynamicResource LocOpt_AfterConversionSection}">
                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocProcessing_VerifyAfterConversion}"
                                Description="{DynamicResource LocProcessing_VerifyAfterConversionDesc}">
                        <CheckBox x:Name="VerifyAfterConversionCheckBox"
                                  IsChecked="{Binding VerifyAfterConversion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocProcessing_VerifyAfterConversion}" />
                    </opt:OptRow>

                    <!-- Sources are deleted only after a verified result, so this needs the check above. -->
                    <opt:OptRow IsEnabled="{Binding VerifyAfterConversion}"
                                Title="{DynamicResource LocOpt_DeleteSourceTitle}"
                                Description="{Binding DeleteSourceDescription}">
                        <ComboBox x:Name="DeleteSourceComboBox"
                                  ItemsSource="{Binding DeleteSourceOptions}"
                                  SelectedItem="{Binding SelectedDeleteSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocOpt_DeleteSourceTitle}" />
                    </opt:OptRow>

                    <opt:OptRow Title="{DynamicResource LocOpt_M3uTitle}"
                                Description="{Binding M3uDescription}">
                        <ComboBox x:Name="M3uComboBox"
                                  ItemsSource="{Binding M3uOptions}"
                                  SelectedItem="{Binding SelectedM3u, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemTemplate="{StaticResource ChoiceOptionLabelTemplate}"
                                  Style="{StaticResource Win11SettingsComboBox}"
                                  AutomationProperties.Name="{DynamicResource LocOpt_M3uTitle}" />
                    </opt:OptRow>

                    <opt:OptRow Placement="Leading"
                                Title="{DynamicResource LocProcessing_CopyMatchingSbi}"
                                Description="{DynamicResource LocProcessing_CopyMatchingSbiDesc}">
                        <CheckBox x:Name="CopyMatchingSbiCheckBox"
                                  IsChecked="{Binding CopyMatchingSbi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Win11SettingsCheckBox}"
                                  AutomationProperties.Name="{DynamicResource LocProcessing_CopyMatchingSbi}" />
                    </opt:OptRow>
                </opt:OptSection>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
