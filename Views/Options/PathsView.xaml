<UserControl x:Class="HakamiqChdTool.App.Views.Options.PathsSettingsView"
             x:Name="PathsSettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{DynamicResource App.FlowDirection}"
             Language="{DynamicResource App.XmlLanguage}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ToolTip x:Key="AppTip.PathsView.1"
                     x:Shared="False"
                     FlowDirection="{DynamicResource App.FlowDirection}"
                     Language="{DynamicResource App.XmlLanguage}"
                     Content="{DynamicResource LocPaths_IncludeSubfoldersDesc}">
                <ToolTip.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                                   MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                    </DataTemplate>
                </ToolTip.ContentTemplate>
            </ToolTip>

            <ToolTip x:Key="AppTip.PathsView.2"
