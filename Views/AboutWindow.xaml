<Window x:Class="HakamiqChdTool.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="{DynamicResource Window.About.Width}"
        Height="{DynamicResource Window.About.Height}"
        MinWidth="{DynamicResource Window.About.MinWidth}"
        MinHeight="{DynamicResource Window.About.MinHeight}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Icon="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamily.Text}"
        d:DesignWidth="640"
        d:DesignHeight="600">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ToolTip x:Key="AppTip.AboutWindow.1"
                     x:Shared="False"
                     FlowDirection="{DynamicResource App.FlowDirection}"
                     Language="{DynamicResource App.XmlLanguage}"
                     Content="{DynamicResource LocCommon_Close}">
                <ToolTip.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource BidiTextConverter}, ConverterParameter=Mixed}"
                                   MaxWidth="{DynamicResource Layout.ToolTip.TextMaxWidth}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   LineHeight="{DynamicResource Font.LineHeight.ToolTip}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="{DynamicResource FontFamily.Base}"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   FlowDirection="{DynamicResource App.FlowDirection}"
                                   Language="{DynamicResource App.XmlLanguage}"
                                   TextAlignment="{DynamicResource App.DefaultTextAlignment}" />
                    </DataTemplate>
                </ToolTip.ContentTemplate>
            </ToolTip>

            <Style x:Key="About.GeneralText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="About.WindowTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Body}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.ProductTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Display}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Title}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.BodyText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="About.SectionPrimaryText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Body}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.SectionSecondaryText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="About.LinkText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="About.LinkButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="About.ContributorCard"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource InnerCardStyle}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="2" />
            </Style>

            <Style x:Key="About.ContributorAction"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource TransparentButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="{DynamicResource Inset.None}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ToolTip" Value="{DynamicResource LocAbout_CreditDiscordTooltip}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}" Value="quantularity">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Tag" Value="https://discord.gg/bside" />
                        <Setter Property="AutomationProperties.Name" Value="Quantularity Discord" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}" Value="hx11">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Tag" Value="https://discord.gg/xEV5wutKXM" />
                        <Setter Property="AutomationProperties.Name" Value="Mohammed Discord" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="About.StaticContributorIcon"
                   TargetType="{x:Type Border}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="{DynamicResource Brush.Control.Fill.Rest}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness" Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}" Value="v9tn">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.48}"
                            CornerRadius="{DynamicResource Radius.Window}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Inset.None}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Layer.Canvas}"
            TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="{DynamicResource Inset.1.All}"
            CornerRadius="{DynamicResource Radius.Window}"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource Grid.Space.48}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{DynamicResource Grid.Space.56}" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.0.0.0.1}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    SnapsToDevicePixels="True">

                <Grid Margin="{DynamicResource Inset.16.0.16.0}"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding WindowTitle, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource About.WindowTitleText}"
                               d:Text="حول Hakamiq CHD Tool" />

                    <Button Grid.Column="2"
                            Width="{DynamicResource Space.32}"
                            Height="{DynamicResource Space.32}"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{StaticResource AppTip.AboutWindow.1}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="{DynamicResource Inset.20.16.20.16}"
                  FlowDirection="{DynamicResource App.FlowDirection}"
                  Language="{DynamicResource App.XmlLanguage}"
                  SnapsToDevicePixels="True">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{DynamicResource Grid.Space.16}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{DynamicResource Grid.Space.16}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="{DynamicResource Space.80}"
                                Height="{DynamicResource Space.80}"
                                Background="{DynamicResource Brush.Accent.Subtle}"
                                BorderBrush="{DynamicResource Brush.Accent.SelectedBorder}"
                                BorderThickness="{DynamicResource Inset.1.All}"
                                CornerRadius="{DynamicResource Radius.Card.Large}"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Image Source="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.png"
                                   Width="{DynamicResource Space.72}"
                                   Height="{DynamicResource Space.72}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProductName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource About.ProductTitleText}"
                                       d:Text="Hakamiq CHD Tool" />

                            <Grid Margin="{DynamicResource Inset.0.6.0.0}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="{DynamicResource Inset.8.4}"
                                        Background="{DynamicResource Brush.Accent.Subtle}"
                                        BorderBrush="{DynamicResource Brush.Accent.SelectedBorder}"
                                        BorderThickness="{DynamicResource Inset.1.All}"
                                        CornerRadius="{DynamicResource Radius.Pill}">
                                    <TextBlock Text="{Binding VersionLabel, Mode=OneWay}"
                                               FontFamily="{DynamicResource FontFamily.Monospace}"
                                               FlowDirection="LeftToRight"
                                               Language="en-US"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent.Text}"
                                               Style="{StaticResource Text.Caption}"
                                               d:Text="vX.Y.Z" />
                                </Border>
                            </Grid>

                            <TextBlock Margin="{DynamicResource Inset.0.8.0.0}"
                                       Text="{Binding Description, Mode=OneWay}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource About.BodyText}"
                                       d:Text="إدارة وتحويل صور الأقراص إلى صيغة CHD باستخدام أداة chdman." />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Brush.Layer.Surface}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="{DynamicResource Inset.1.All}"
                            CornerRadius="{DynamicResource Radius.Card.Large}"
                            Padding="{DynamicResource Inset.16.14}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                <RowDefinition Height="{DynamicResource Grid.Space.1}" />
                                <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding DeveloperLine, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource About.SectionPrimaryText}"
                                       d:Text="تطوير: HAKAMIQ" />

                            <TextBlock Grid.Row="2"
                                       Text="{Binding LicenseLine, Mode=OneWay}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource About.SectionSecondaryText}"
                                       d:Text="مرخص بموجب MIT." />

                            <Border Grid.Row="4"
                                    Height="{DynamicResource Space.1}"
                                    Background="{DynamicResource Brush.Border.Subtle}" />

                            <ItemsControl Grid.Row="6"
                                          ItemsSource="{Binding Links, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{DynamicResource Layout.About.LinkColumns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="{DynamicResource Inset.4.All}"
                                                Style="{StaticResource About.LinkButton}"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding DisplayName, Mode=OneWay}"
                                                AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}">
                                            <Grid FlowDirection="{DynamicResource App.FlowDirection}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding IconGlyph, Mode=OneWay}"
                                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.IconMedium}"
                                                           FlowDirection="LeftToRight"
                                                           Language="en-US"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource About.LinkText}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.4}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.8}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding CreditsTitle, Mode=OneWay}"
                                   Style="{StaticResource About.SectionPrimaryText}"
                                   d:Text="شكر وتقدير" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding CreditsDescription, Mode=OneWay}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource About.SectionSecondaryText}"
                                   d:Text="كل الشكر والتقدير لكل من ساهم بدعم المشروع." />

                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding Credits, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource About.ContributorCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FlowDirection="LeftToRight"
                                                           Language="ar-SA"
                                                           TextAlignment="Right"
                                                           Style="{StaticResource Text.BodyStrong}" />
                                            </StackPanel>

                                            <Grid Grid.Column="2">
                                                <Button Click="ContributorDiscordButton_Click"
                                                        Style="{StaticResource About.ContributorAction}">
                                                    <TextBlock Text=""
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.IconMedium}"
                                                               FlowDirection="LeftToRight"
                                                               Language="en-US"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Button>

                                                <Border Style="{StaticResource About.StaticContributorIcon}">
                                                    <TextBlock Text=""
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.IconMedium}"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               FlowDirection="LeftToRight"
                                                               Language="en-US"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}"
                    SnapsToDevicePixels="True">

                <Grid Margin="{DynamicResource Inset.16.0.16.0}"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.16}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding LastErrorMessage, Mode=OneWay}"
                               Foreground="{DynamicResource Brush.Error.Foreground}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource Text.Caption}" />

                    <Button Grid.Column="2"
                            Width="{DynamicResource Space.112}"
                            Height="{DynamicResource Space.40}"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CloseButton_Click"
                            Content="{DynamicResource LocCommon_Ok}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Ok}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
