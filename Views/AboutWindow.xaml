<Window x:Class="HakamiqChdTool.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="600"
        Height="600"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Icon="pack://application:,,,/Resources/HakamiqLogo.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamily.Text}"
        d:DesignWidth="600"
        d:DesignHeight="600">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AboutIconLinkButtonStyle"
                   TargetType="{x:Type Button}">
                <Setter Property="Width"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Height"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="MinWidth"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="MinHeight"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.None}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Control.Fill.Rest}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Control.Stroke.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Control.Fill.Hover}" />
                                    <Setter TargetName="Root"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Brush.Control.Stroke.Strong}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Accent.Text}" />
                                </Trigger>

                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Control.Fill.Pressed}" />
                                    <Setter TargetName="Root"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Brush.Control.Stroke.Strong}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Accent.Pressed}" />
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused"
                                         Value="True">
                                    <Setter TargetName="Root"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Brush.Control.Stroke.Focus}" />
                                </Trigger>

                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter TargetName="Root"
                                            Property="Background"
                                            Value="{DynamicResource Brush.Control.Fill.Disabled}" />
                                    <Setter TargetName="Root"
                                            Property="BorderBrush"
                                            Value="{DynamicResource Brush.Border.Subtle}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource Brush.Text.Disabled}" />
                                    <Setter Property="Cursor"
                                            Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="About.HeaderTextColumn"
                   TargetType="{x:Type StackPanel}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="About.GeneralText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="About.WindowTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Body}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.ProductTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Display}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Title}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.BodyText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="About.LabelText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Accent.Text}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.SectionPrimaryText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Body}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
            </Style>

            <Style x:Key="About.SectionSecondaryText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource About.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="About.TechnicalText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FlowDirection"
                        Value="LeftToRight" />
                <Setter Property="Language"
                        Value="en-US" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="About.CreditCardBorder"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Control.Fill.Rest}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Control.Stroke.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.All}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="About.CreditDiscordButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource AboutIconLinkButtonStyle}">
                <Setter Property="Width"
                        Value="32" />
                <Setter Property="Height"
                        Value="32" />
                <Setter Property="MinWidth"
                        Value="32" />
                <Setter Property="MinHeight"
                        Value="32" />
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Setter Property="ToolTip"
                        Value="{DynamicResource LocAbout_CreditDiscordTooltip}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}"
                                 Value="quantularity">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Setter Property="Tag"
                                Value="https://discord.gg/bside" />
                        <Setter Property="AutomationProperties.Name"
                                Value="Quantularity Discord" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}"
                                 Value="hx11">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Setter Property="Tag"
                                Value="https://discord.gg/xEV5wutKXM" />
                        <Setter Property="AutomationProperties.Name"
                                Value="Mohammed Discord" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="About.StaticDiscordIconBorderStyle"
                   TargetType="{x:Type Border}">
                <Setter Property="Width"
                        Value="32" />
                <Setter Property="Height"
                        Value="32" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Control.Fill.Rest}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Control.Stroke.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Handle, Mode=OneWay}"
                                 Value="v9tn">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.40}"
                            CornerRadius="{DynamicResource Radius.Window}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Inset.None}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Layer.Canvas}"
            TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="{DynamicResource Inset.1.All}"
            CornerRadius="{DynamicResource Radius.Window}"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource Grid.Space.48}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{DynamicResource Grid.Space.56}" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.0.0.0.1}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    SnapsToDevicePixels="True">

                <Grid Margin="{DynamicResource Inset.16.0.16.0}"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource About.WindowTitleText}"
                               Text="{Binding WindowTitle, Mode=OneWay}"
                               d:Text="حول Hakamiq CHD Tool" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                FlowDirection="{DynamicResource App.CaptionButtonsFlowDirection}"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button Width="{DynamicResource Space.32}"
                                Height="{DynamicResource Space.32}"
                                VerticalAlignment="Center"
                                Click="CloseButton_Click"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                ToolTip="{DynamicResource LocCommon_Close}"
                                AutomationProperties.Name="{DynamicResource LocCommon_Close}">

                            <Viewbox Width="{DynamicResource Space.12}"
                                     Height="{DynamicResource Space.12}"
                                     FlowDirection="LeftToRight"
                                     Stretch="Uniform">

                                <Path Data="{StaticResource Icon.Close}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <Grid Margin="{DynamicResource Inset.16.All}"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      SnapsToDevicePixels="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="{DynamicResource Space.64}"
                            Height="{DynamicResource Space.64}"
                            Background="{DynamicResource HeaderLogoPlateBackgroundBrush}"
                            BorderBrush="{DynamicResource HeaderLogoPlateBorderBrush}"
                            BorderThickness="{DynamicResource Inset.1.All}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">

                        <Image Source="pack://application:,,,/Resources/HakamiqLogo.png"
                               Width="{DynamicResource Space.64}"
                               Height="{DynamicResource Space.64}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                MinWidth="0"
                                Style="{StaticResource About.HeaderTextColumn}">

                        <TextBlock Text="{Binding ProductName, Mode=OneWay}"
                                   d:Text="Hakamiq CHD Tool"
                                   Style="{StaticResource About.ProductTitleText}" />

                        <StackPanel Margin="{DynamicResource Inset.0.4.0.0}"
                                    Orientation="Horizontal"
                                    FlowDirection="{DynamicResource App.FlowDirection}">

                            <TextBlock Text="{DynamicResource LocAbout_VersionLabel}"
                                       Style="{StaticResource About.LabelText}" />

                            <TextBlock Margin="{DynamicResource Inset.6.0.0.0}"
                                       Text="{Binding VersionLabel, Mode=OneWay}"
                                       d:Text="v1.1.0"
                                       FontFamily="{DynamicResource FontFamily.Text}"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       FontWeight="{DynamicResource FontWeight.SemiBold}"
                                       Foreground="{DynamicResource Brush.Accent.Text}"
                                       Style="{StaticResource About.TechnicalText}" />
                        </StackPanel>

                        <TextBlock Margin="{DynamicResource Inset.0.6.0.0}"
                                   Text="{Binding Description, Mode=OneWay}"
                                   d:Text="أداة احترافية لتحويل وإدارة ملفات CHD."
                                   Style="{StaticResource About.BodyText}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Layer.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="{DynamicResource Inset.1.All}"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Padding="{DynamicResource Inset.16.All}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding DeveloperLine, Mode=OneWay}"
                                   d:Text="المطور: Qasim Hakami"
                                   Style="{StaticResource About.SectionPrimaryText}" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding LicenseLine, Mode=OneWay}"
                                   d:Text="مرخص بموجب MIT."
                                   Style="{StaticResource About.SectionSecondaryText}" />

                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding Links, Mode=OneWay}"
                                      HorizontalAlignment="Center">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                FlowDirection="{DynamicResource App.FlowDirection}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="{DynamicResource Inset.4.All}"
                                            Style="{StaticResource AboutIconLinkButtonStyle}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}">

                                        <Button.ToolTip>
                                            <ToolTip FlowDirection="{DynamicResource App.FlowDirection}">
                                                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                           FlowDirection="{DynamicResource App.FlowDirection}"
                                                           TextAlignment="Left" />
                                            </ToolTip>
                                        </Button.ToolTip>

                                        <TextBlock Text="{Binding IconGlyph, Mode=OneWay}"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.IconMedium}"
                                                   FlowDirection="LeftToRight"
                                                   Language="en-US"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="{DynamicResource Brush.Layer.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="{DynamicResource Inset.1.All}"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Padding="{DynamicResource Inset.16.All}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                    <Grid FlowDirection="{DynamicResource App.FlowDirection}"
                          Language="{DynamicResource App.XmlLanguage}"
                          SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding CreditsTitle, Mode=OneWay}"
                                   d:Text="شكر وتقدير"
                                   Style="{StaticResource About.SectionPrimaryText}" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding CreditsDescription, Mode=OneWay}"
                                   d:Text="كل الشكر والتقدير لكل من ساهم بدعم المشروع."
                                   Style="{StaticResource About.SectionSecondaryText}" />

                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding Credits, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="{DynamicResource Inset.4.All}"
                                            Style="{StaticResource About.CreditCardBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName, Mode=OneWay}"
                                                       FlowDirection="LeftToRight"
                                                       TextAlignment="Right"
                                                       Language="ar-SA"
                                                       Style="{StaticResource About.SectionPrimaryText}" />

                                            <Grid Grid.Column="1"
                                                  Margin="{DynamicResource Inset.8.0.0.0}">
                                                <Button Click="ContributorDiscordButton_Click"
                                                        Style="{StaticResource About.CreditDiscordButtonStyle}">
                                                    <TextBlock Text=""
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.IconMedium}"
                                                               FlowDirection="LeftToRight"
                                                               Language="en-US"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Button>

                                                <Border Style="{StaticResource About.StaticDiscordIconBorderStyle}">
                                                    <TextBlock Text=""
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.IconMedium}"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               FlowDirection="LeftToRight"
                                                               Language="en-US"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Layer.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}"
                    SnapsToDevicePixels="True">

                <Grid Margin="{DynamicResource Inset.16.0.16.0}"
                      FlowDirection="{DynamicResource App.FlowDirection}"
                      Language="{DynamicResource App.XmlLanguage}"
                      SnapsToDevicePixels="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Width="{DynamicResource Space.112}"
                            Height="{DynamicResource Space.40}"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CloseButton_Click"
                            Content="{DynamicResource LocCommon_Ok}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Ok}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
