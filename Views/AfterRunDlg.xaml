<Window x:Class="HakamiqChdTool.App.Views.AfterRunCountdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Topmost="True"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Icon="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.ico"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource FontFamily.Text}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.40}"
                            CornerRadius="{DynamicResource Radius.Dialog}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Inset.None}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource Win11.DialogRootFrame}">
        <Grid FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Win11.DialogTopBar}">
                <TextBlock x:Name="TitleText" Style="{StaticResource Win11.DialogTitleText}" />
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Win11.DialogContentHost}">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Win11.DialogActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NowButton"
                            Grid.Column="1"
                            MinWidth="{DynamicResource Space.112}"
                            Click="NowButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="{DynamicResource LocAfterRun_Now}"
                            Content="{DynamicResource LocAfterRun_Now}" />
                    <Button x:Name="CancelButton"
                            Grid.Column="3"
                            MinWidth="{DynamicResource Space.112}"
                            IsCancel="True"
                            IsDefault="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{DynamicResource LocAfterRun_Cancel}"
                            Content="{DynamicResource LocAfterRun_Cancel}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
