<Window x:Class="HakamiqChdTool.App.Views.OrphanedCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource LocOrphanedCleanup_PromptTitle}"
        Width="640"
        MinWidth="580"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        Icon="pack://application:,,,/Resources/HakamiqLogo.ico"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource FontFamily.Text}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="OrphanedCleanupDialog.RootFrame"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Dialog}" />
                <Setter Property="TextElement.Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="ClipToBounds"
                        Value="True" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.Bar"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.10}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.ContentHost"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Canvas}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.All}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.Card"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Card.Large}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.All}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.WarningCard"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.Card}">
                <Setter Property="Background"
                        Value="{DynamicResource WarningSoftBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource WarningBorderBrush}" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.WarningIconPlate"
                   TargetType="{x:Type Border}">
                <Setter Property="Width"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Height"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource WarningBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Top" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.MetricCard"
                   TargetType="{x:Type Border}">
                <Setter Property="MinHeight"
                        Value="{DynamicResource Space.64}" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Card}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.All}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.InfoSurface"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.All}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.GeneralText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.TitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.HeaderTitle}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.SectionTitleText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodyStrong}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.BodyText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="TextTrimming"
                        Value="None" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.WarningBodyText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.BodyText}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.MetricLabelText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.CaptionSmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.MetricValueText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource OrphanedCleanupDialog.GeneralText}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodyStrong}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OrphanedCleanupDialog.TechnicalText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Mono}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.CaptionSmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource TechnicalText.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="TextTrimming"
                        Value="None" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.40}"
                            CornerRadius="{DynamicResource Radius.Dialog}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Inset.None}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource OrphanedCleanupDialog.RootFrame}">
        <Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource OrphanedCleanupDialog.Bar}"
                    BorderThickness="{DynamicResource Inset.0.0.0.1}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource LocOrphanedCleanup_PromptTitle}"
                               Style="{StaticResource OrphanedCleanupDialog.TitleText}"
                               VerticalAlignment="Center" />

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Width="{DynamicResource Space.32}"
                            Height="{DynamicResource Space.32}"
                            MinWidth="{DynamicResource Space.32}"
                            Padding="{DynamicResource Inset.None}"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{DynamicResource LocCommon_Close}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            Click="SkipButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="440"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          Background="{DynamicResource Brush.Transparent}"
                          SnapsToDevicePixels="True">

                <Border Style="{StaticResource OrphanedCleanupDialog.ContentHost}">
                    <StackPanel>
                        <Border Style="{StaticResource OrphanedCleanupDialog.WarningCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource OrphanedCleanupDialog.WarningIconPlate}">
                                    <TextBlock Text="⚠"
                                               FontSize="{DynamicResource FontSize.BodyStrong}"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               FlowDirection="LeftToRight"
                                               Language="en-US"
                                               TextAlignment="Left"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LocOrphanedCleanup_WarningTitle}"
                                               Style="{StaticResource OrphanedCleanupDialog.SectionTitleText}" />

                                    <TextBlock Margin="{DynamicResource Inset.0.6.0.0}"
                                               Text="{Binding SummaryText, Mode=OneWay}"
                                               Style="{StaticResource OrphanedCleanupDialog.WarningBodyText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                Style="{StaticResource OrphanedCleanupDialog.Card}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource LocOrphanedCleanup_ScanSummaryTitle}"
                                           Style="{StaticResource OrphanedCleanupDialog.SectionTitleText}" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource OrphanedCleanupDialog.MetricCard}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LocOrphanedCleanup_ItemsLabel}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricLabelText}" />

                                            <TextBlock Margin="{DynamicResource Inset.0.4.0.0}"
                                                       Text="{Binding ItemCountText, Mode=OneWay}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricValueText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource OrphanedCleanupDialog.MetricCard}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LocOrphanedCleanup_FilesLabel}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricLabelText}" />

                                            <TextBlock Margin="{DynamicResource Inset.0.4.0.0}"
                                                       Text="{Binding FileCountText, Mode=OneWay}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricValueText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4"
                                            Style="{StaticResource OrphanedCleanupDialog.MetricCard}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LocOrphanedCleanup_SizeLabel}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricLabelText}" />

                                            <TextBlock Margin="{DynamicResource Inset.0.4.0.0}"
                                                       Text="{Binding ReclaimableSizeText, Mode=OneWay}"
                                                       Style="{StaticResource OrphanedCleanupDialog.MetricValueText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="4"
                                        Style="{StaticResource OrphanedCleanupDialog.InfoSurface}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LocOrphanedCleanup_TempRootLabel}"
                                                   Style="{StaticResource OrphanedCleanupDialog.MetricLabelText}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Left" />

                                        <TextBlock Margin="{DynamicResource Inset.0.6.0.0}"
                                                   Text="{Binding ProcessTempRootText, Mode=OneWay}"
                                                   Style="{StaticResource OrphanedCleanupDialog.TechnicalText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                Style="{StaticResource OrphanedCleanupDialog.Card}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{DynamicResource LocOrphanedCleanup_SafetyTitle}"
                                           Style="{StaticResource OrphanedCleanupDialog.SectionTitleText}" />

                                <Border Grid.Row="2"
                                        Style="{StaticResource OrphanedCleanupDialog.InfoSurface}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.10}" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.10}" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.10}" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.10}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{DynamicResource LocOrphanedCleanup_SafetyTempOnly}"
                                                   Style="{StaticResource OrphanedCleanupDialog.BodyText}" />

                                        <Border Grid.Row="2"
                                                Height="1"
                                                Background="{DynamicResource Brush.Border.Subtle}" />

                                        <TextBlock Grid.Row="4"
                                                   Text="{DynamicResource LocOrphanedCleanup_SafetyNoSourceOutput}"
                                                   Style="{StaticResource OrphanedCleanupDialog.BodyText}" />

                                        <Border Grid.Row="6"
                                                Height="1"
                                                Background="{DynamicResource Brush.Border.Subtle}" />

                                        <TextBlock Grid.Row="8"
                                                   Text="{DynamicResource LocOrphanedCleanup_SafetyManualConfirm}"
                                                   Style="{StaticResource OrphanedCleanupDialog.BodyText}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource OrphanedCleanupDialog.Bar}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LaterButton"
                            Grid.Column="1"
                            MinWidth="{DynamicResource Space.112}"
                            Content="{DynamicResource LocOrphanedCleanup_LaterButton}"
                            AutomationProperties.Name="{DynamicResource LocOrphanedCleanup_LaterButton}"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SkipButton_Click" />

                    <Button x:Name="CleanNowButton"
                            Grid.Column="3"
                            MinWidth="{DynamicResource Space.112}"
                            Content="{DynamicResource LocOrphanedCleanup_CleanNowButton}"
                            AutomationProperties.Name="{DynamicResource LocOrphanedCleanup_CleanNowButton}"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="CleanButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>