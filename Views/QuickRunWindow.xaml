<Window x:Class="HakamiqChdTool.App.Views.QuickRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Width="520"
        Height="420"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        NumberSubstitution.Substitution="European"
        Icon="pack://application:,,,/HakamiqChdTool;component/Resources/HakamiqLogo.ico"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource FontFamily.Text}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HakamiqChdTool;component/Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="QuickBoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.40}"
                            CornerRadius="{DynamicResource Radius.Dialog}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource Win11.DialogRootFrame}">
        <Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource Win11.DialogTopBar}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="QuickTitleText"
                               Text="{Binding Title}"
                               Style="{StaticResource Win11.DialogTitleText}" />

                    <Button Grid.Column="1"
                            Width="{DynamicResource Space.32}"
                            Height="{DynamicResource Space.32}"
                            MinWidth="{DynamicResource Space.32}"
                            Padding="{DynamicResource Inset.None}"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{DynamicResource LocCommon_Close}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="{DynamicResource Inset.16.All}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="QuickDeleteWarning"
                        Grid.Row="0"
                        Margin="{DynamicResource Inset.0.0.0.12}"
                        Padding="{DynamicResource Inset.12.All}"
                        Background="{DynamicResource Brush.Layer.Card}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control.Large}"
                        Visibility="{Binding ShowDeleteWarning, Converter={StaticResource QuickBoolToVisibility}}">
                    <TextBlock Text="{Binding DeleteWarningText}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.Layer.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control.Large}">
                    <ListView x:Name="QuickList"
                              ItemsSource="{Binding Items}"
                              Background="{DynamicResource Brush.Transparent}"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              AutomationProperties.Name="{Binding Title}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="{DynamicResource Inset.8.4}" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding FileName}"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OriginalPath}" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding StatusHeadlineIsolated}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <ProgressBar Grid.Row="2"
                                                 Height="4"
                                                 Margin="{DynamicResource Inset.0.4.0.0}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 FlowDirection="{DynamicResource App.FlowDirection}"
                                                 Value="{Binding ProgressBarDisplayValue, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                 Visibility="{Binding IsProgressActive, Converter={StaticResource QuickBoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel x:Name="QuickResultPanel"
                            Grid.Row="2"
                            Margin="{DynamicResource Inset.0.12.0.0}"
                            Visibility="{Binding HasResult, Converter={StaticResource QuickBoolToVisibility}}">
                    <TextBlock Text="{Binding ResultTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ResultMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource Win11.DialogActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="QuickStatusText"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <StackPanel Grid.Column="1" Margin="{DynamicResource Inset.8.0.0.0}" Orientation="Horizontal">
                        <Button x:Name="QuickDetailsButton"
                                Command="{Binding DetailsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding HasResult, Converter={StaticResource QuickBoolToVisibility}}"
                                AutomationProperties.Name="{DynamicResource LocRunSummary_Details}"
                                Content="{DynamicResource LocRunSummary_Details}" />
                        <Button x:Name="QuickOpenInAppButton"
                                Margin="{DynamicResource Inset.8.0.0.0}"
                                Command="{Binding OpenInAppCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{DynamicResource LocQuick_OpenInAppDesc}"
                                AutomationProperties.Name="{DynamicResource LocQuick_OpenInApp}"
                                Content="{DynamicResource LocQuick_OpenInApp}" />
                        <Button x:Name="QuickStartButton"
                                Margin="{DynamicResource Inset.8.0.0.0}"
                                MinWidth="{DynamicResource Space.112}"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsWaitingForStart, Converter={StaticResource QuickBoolToVisibility}}"
                                AutomationProperties.Name="{DynamicResource LocQuick_Start}"
                                Content="{DynamicResource LocQuick_Start}" />
                        <Button x:Name="QuickCancelButton"
                                Margin="{DynamicResource Inset.8.0.0.0}"
                                MinWidth="{DynamicResource Space.112}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsRunning, Converter={StaticResource QuickBoolToVisibility}}"
                                AutomationProperties.Name="{DynamicResource LocQuick_Stop}"
                                Content="{DynamicResource LocQuick_Stop}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
