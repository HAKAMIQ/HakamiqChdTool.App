<Window x:Class="HakamiqChdTool.App.Views.RedumpDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource LocRedumpDetails_Title}"
        Width="840"
        MinWidth="760"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Layer.Canvas}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FlowDirection="{DynamicResource App.FlowDirection}"
        Language="{DynamicResource App.XmlLanguage}"
        FontFamily="{DynamicResource FontFamily.Text}"
        Icon="pack://application:,,,/Resources/HakamiqLogo.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Style/OptsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RedumpDetails.Root"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Dialog}" />
                <Setter Property="ClipToBounds"
                        Value="True" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.Bar"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.10}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.ContentHost"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Canvas}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.All}" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.Card"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Card}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Card.Large}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.16.All}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="ClipToBounds"
                        Value="True" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.HeroCard"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource RedumpDetails.Card}">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Strong}" />
            </Style>

            <Style x:Key="RedumpDetails.IconPlate"
                   TargetType="{x:Type Border}">
                <Setter Property="Width"
                        Value="44" />
                <Setter Property="Height"
                        Value="44" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Accent.SelectedBorder}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control.Large}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="RedumpDetails.SectionIconPlate"
                   TargetType="{x:Type Border}">
                <Setter Property="Width"
                        Value="32" />
                <Setter Property="Height"
                        Value="32" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="RedumpDetails.MetaStrip"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="ClipToBounds"
                        Value="True" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.MetaCell"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Transparent}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.14.10}" />
                <Setter Property="MinHeight"
                        Value="64" />
                <Setter Property="VerticalAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="RedumpDetails.StateCallout"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Accent.SelectedBorder}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.10}" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="RedumpDetails.DataSurface"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Subtle}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.14.10}" />
                <Setter Property="MinHeight"
                        Value="84" />
                <Setter Property="MaxHeight"
                        Value="180" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="ClipToBounds"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.Text"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FlowDirection"
                        Value="{DynamicResource App.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource App.XmlLanguage}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.WindowTitle"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.HeaderTitle}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RedumpDetails.FileTitle"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource TechnicalText.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Subtitle}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="RedumpDetails.SectionTitle"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodyStrong}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RedumpDetails.Label"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.CaptionSmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Muted}" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RedumpDetails.Value"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource TechnicalText.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Text}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="NoWrap" />
                <Setter Property="TextTrimming"
                        Value="CharacterEllipsis" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="RedumpDetails.Body"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.BodySmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.Regular}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="LineHeight"
                        Value="{DynamicResource Font.LineHeight.Body}" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
            </Style>

            <Style x:Key="RedumpDetails.StateText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Body}">
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Accent.Text}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
            </Style>

            <Style x:Key="RedumpDetails.HashText"
                   TargetType="{x:Type TextBlock}">
                <Setter Property="FlowDirection"
                        Value="{DynamicResource TechnicalText.FlowDirection}" />
                <Setter Property="Language"
                        Value="{DynamicResource TechnicalText.Language}" />
                <Setter Property="FontFamily"
                        Value="{DynamicResource FontFamily.Mono}" />
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.Caption}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="TextTrimming"
                        Value="None" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="SnapsToDevicePixels"
                        Value="True" />
                <Setter Property="UseLayoutRounding"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.HashContent"
                   TargetType="{x:Type ScrollViewer}">
                <Setter Property="Visibility"
                        Value="Collapsed" />
                <Setter Property="VerticalScrollBarVisibility"
                        Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility"
                        Value="Disabled" />
                <Setter Property="Focusable"
                        Value="False" />
                <Setter Property="CanContentScroll"
                        Value="True" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCopyableHashes}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.HashEmptyState"
                   TargetType="{x:Type Grid}">
                <Setter Property="Visibility"
                        Value="Visible" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCopyableHashes}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.StatusBadge"
                   TargetType="{x:Type Border}">
                <Setter Property="MinWidth"
                        Value="136" />
                <Setter Property="MaxWidth"
                        Value="320" />
                <Setter Property="MinHeight"
                        Value="40" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.8}" />
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Layer.Surface}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Border.Default}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Success">
                        <Setter Property="Background"
                                Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource SuccessBorderBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Warning">
                        <Setter Property="Background"
                                Value="{DynamicResource WarningSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource WarningBorderBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Error">
                        <Setter Property="Background"
                                Value="{DynamicResource ErrorSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource ErrorBorderBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding ShowStatusBadge}"
                                 Value="False">
                        <Setter Property="Visibility"
                                Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.StatusBadgeText"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.CaptionSmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="TextAlignment"
                        Value="Left" />
                <Setter Property="TextWrapping"
                        Value="Wrap" />
                <Setter Property="TextTrimming"
                        Value="None" />
                <Setter Property="LineStackingStrategy"
                        Value="BlockLineHeight" />
                <Setter Property="LineHeight"
                        Value="18" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="MaxWidth"
                        Value="296" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Success">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Warning">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Error">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.ProgressPanel"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Brush.Accent.SelectedBorder}" />
                <Setter Property="BorderThickness"
                        Value="{DynamicResource Inset.1.All}" />
                <Setter Property="CornerRadius"
                        Value="{DynamicResource Radius.Control}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.10}" />
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVerificationInProgress}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.ResultPanel"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource RedumpDetails.StateCallout}">
                <Setter Property="Visibility"
                        Value="Collapsed" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowVerificationResult}"
                                 Value="True">
                        <Setter Property="Visibility"
                                Value="Visible" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Success">
                        <Setter Property="Background"
                                Value="{DynamicResource SuccessSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource SuccessBorderBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Warning">
                        <Setter Property="Background"
                                Value="{DynamicResource WarningSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource WarningBorderBrush}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding VerificationTone}"
                                 Value="Error">
                        <Setter Property="Background"
                                Value="{DynamicResource ErrorSoftBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource ErrorBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RedumpDetails.PrimaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinWidth"
                        Value="140" />
                <Setter Property="MinHeight"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.14.10}" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.SecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinWidth"
                        Value="112" />
                <Setter Property="MinHeight"
                        Value="{DynamicResource Space.40}" />
                <Setter Property="Padding"
                        Value="{DynamicResource Inset.12.10}" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                        Value="True" />
            </Style>

            <Style x:Key="RedumpDetails.Feedback"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource RedumpDetails.Text}">
                <Setter Property="FontSize"
                        Value="{DynamicResource FontSize.CaptionSmall}" />
                <Setter Property="FontWeight"
                        Value="{DynamicResource FontWeight.SemiBold}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource Brush.Success}" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCopyFeedbackError}"
                                 Value="True">
                        <Setter Property="Foreground"
                                Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{DynamicResource Space.40}"
                            CornerRadius="{DynamicResource Radius.Dialog}"
                            GlassFrameThickness="{DynamicResource Inset.None}"
                            ResizeBorderThickness="{DynamicResource Inset.None}"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource RedumpDetails.Root}">
        <Grid ClipToBounds="True"
              FlowDirection="{DynamicResource App.FlowDirection}"
              Language="{DynamicResource App.XmlLanguage}"
              SnapsToDevicePixels="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource RedumpDetails.Bar}"
                    BorderThickness="{DynamicResource Inset.0.0.0.1}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource LocRedumpDetails_Title}"
                               Style="{StaticResource RedumpDetails.WindowTitle}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Width="{DynamicResource Space.32}"
                            Height="{DynamicResource Space.32}"
                            MinWidth="{DynamicResource Space.32}"
                            Padding="{DynamicResource Inset.None}"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{DynamicResource LocCommon_Close}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            Command="{Binding CloseCommand}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <Viewbox Width="{DynamicResource Space.12}"
                                 Height="{DynamicResource Space.12}"
                                 FlowDirection="LeftToRight"
                                 Stretch="Uniform">
                            <Path Data="{StaticResource Icon.Close}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource RedumpDetails.ContentHost}">

                <ScrollViewer MaxHeight="560"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              Focusable="False"
                              Background="{DynamicResource Brush.Transparent}">

                    <StackPanel>
                        <Border Style="{StaticResource RedumpDetails.HeroCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource RedumpDetails.IconPlate}">
                                        <Viewbox Width="{DynamicResource Space.24}"
                                                 Height="{DynamicResource Space.24}"
                                                 FlowDirection="LeftToRight"
                                                 Stretch="Uniform">
                                            <Path Data="{StaticResource Icon.Games}"
                                                  Fill="{DynamicResource Brush.Accent.Text}"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayTitle, Mode=OneWay}"
                                               ToolTip="{Binding DisplayTitle, Mode=OneWay}"
                                               Style="{StaticResource RedumpDetails.FileTitle}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                        Style="{StaticResource RedumpDetails.ProgressPanel}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.6}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{DynamicResource LocRedumpDetails_ProgressTitle}"
                                                   Style="{StaticResource RedumpDetails.Label}" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Status, Mode=OneWay}"
                                                   Style="{StaticResource RedumpDetails.StateText}" />
                                    </Grid>
                                </Border>

                                <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                        Style="{StaticResource RedumpDetails.MetaStrip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource RedumpDetails.MetaCell}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LocRedumpDetails_ConsoleTypeLabel}"
                                                           Style="{StaticResource RedumpDetails.Label}" />

                                                <TextBlock Margin="{DynamicResource Inset.0.5.0.0}"
                                                           Text="{Binding ConsoleTypeName, Mode=OneWay}"
                                                           ToolTip="{Binding ConsoleTypeName, Mode=OneWay}"
                                                           Style="{StaticResource RedumpDetails.Value}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Width="1"
                                                Height="{DynamicResource Space.40}"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Border.Subtle}" />

                                        <Border Grid.Column="2"
                                                Style="{StaticResource RedumpDetails.MetaCell}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LocRedumpDetails_SizeLabel}"
                                                           Style="{StaticResource RedumpDetails.Label}" />

                                                <TextBlock Margin="{DynamicResource Inset.0.5.0.0}"
                                                           Text="{Binding SizeDisplay, Mode=OneWay}"
                                                           ToolTip="{Binding SizeDisplay, Mode=OneWay}"
                                                           Style="{StaticResource RedumpDetails.Value}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                        Style="{StaticResource RedumpDetails.ResultPanel}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="{DynamicResource Grid.Space.10}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{DynamicResource LocRedumpDetails_StatusTitle}"
                                                       Style="{StaticResource RedumpDetails.SectionTitle}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource RedumpDetails.StatusBadge}">
                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           Style="{StaticResource RedumpDetails.StatusBadgeText}" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0"
                                                     Width="{DynamicResource Space.18}"
                                                     Height="{DynamicResource Space.18}"
                                                     FlowDirection="LeftToRight"
                                                     Stretch="Uniform"
                                                     VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Info}"
                                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusNote, Mode=OneWay}"
                                                       Style="{StaticResource RedumpDetails.Body}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                Style="{StaticResource RedumpDetails.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource RedumpDetails.SectionIconPlate}">
                                        <Viewbox Width="{DynamicResource Space.18}"
                                                 Height="{DynamicResource Space.18}"
                                                 FlowDirection="LeftToRight"
                                                 Stretch="Uniform">
                                            <Path Data="{StaticResource Icon.DatabaseSearch}"
                                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LocRedumpDetails_HashesTitle}"
                                               Style="{StaticResource RedumpDetails.SectionTitle}"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="4"
                                            Content="{DynamicResource LocUi_Redump_CopyHash}"
                                            AutomationProperties.Name="{DynamicResource LocUi_Redump_CopyHash}"
                                            Command="{Binding CopyHashesCommand}"
                                            IsEnabled="{Binding HasCopyableHashes, Mode=OneWay}"
                                            Style="{StaticResource RedumpDetails.SecondaryButton}" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Style="{StaticResource RedumpDetails.DataSurface}">
                                    <Grid>
                                        <ScrollViewer Style="{StaticResource RedumpDetails.HashContent}">
                                            <TextBlock Text="{Binding HashesSummary, Mode=OneWay}"
                                                       Style="{StaticResource RedumpDetails.HashText}" />
                                        </ScrollViewer>

                                        <Grid Style="{StaticResource RedumpDetails.HashEmptyState}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0"
                                                     Width="{DynamicResource Space.24}"
                                                     Height="{DynamicResource Space.24}"
                                                     FlowDirection="LeftToRight"
                                                     Stretch="Uniform"
                                                     VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.DatabaseSearch}"
                                                      Fill="{DynamicResource Brush.Text.Muted}"
                                                      Stretch="Uniform" />
                                            </Viewbox>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding HashesEmptyText, Mode=OneWay}"
                                                       Style="{StaticResource RedumpDetails.Body}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="{DynamicResource Inset.0.12.0.0}"
                                Style="{StaticResource RedumpDetails.Card}"
                                Visibility="{Binding CanApplyName, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="{DynamicResource Grid.Space.12}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.10}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{DynamicResource Grid.Space.8}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource RedumpDetails.SectionIconPlate}">
                                        <Viewbox Width="{DynamicResource Space.18}"
                                                 Height="{DynamicResource Space.18}"
                                                 FlowDirection="LeftToRight"
                                                 Stretch="Uniform">
                                            <Path Data="{StaticResource Icon.Document}"
                                                  Fill="{DynamicResource Brush.Text.Secondary}"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource LocRedumpDetails_SuggestedNameTitle}"
                                               Style="{StaticResource RedumpDetails.SectionTitle}"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="4"
                                            Content="{DynamicResource LocUi_Redump_CopyName}"
                                            AutomationProperties.Name="{DynamicResource LocUi_Redump_CopyName}"
                                            Command="{Binding CopyNameCommand}"
                                            Style="{StaticResource RedumpDetails.SecondaryButton}" />

                                    <Button Grid.Column="6"
                                            Content="{DynamicResource LocRedumpDetails_ApplyName}"
                                            ToolTip="{DynamicResource LocRedumpDetails_ApplyNameTooltip}"
                                            AutomationProperties.Name="{DynamicResource LocRedumpDetails_ApplyName}"
                                            Command="{Binding ApplyNameCommand}"
                                            IsEnabled="{Binding CanApplyName, Mode=OneWay}"
                                            Style="{StaticResource RedumpDetails.PrimaryButton}" />
                                </Grid>

                                <Border Grid.Row="2"
                                        Style="{StaticResource RedumpDetails.DataSurface}"
                                        MinHeight="52"
                                        MaxHeight="92">
                                    <TextBlock Text="{Binding SuggestedName, Mode=OneWay}"
                                               Style="{StaticResource RedumpDetails.Value}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource RedumpDetails.Bar}"
                    BorderThickness="{DynamicResource Inset.0.1.0.0}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource Grid.Space.12}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{DynamicResource LocCommon_Close}"
                            AutomationProperties.Name="{DynamicResource LocCommon_Close}"
                            Command="{Binding CloseCommand}"
                            IsCancel="True"
                            Style="{StaticResource RedumpDetails.SecondaryButton}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding CopyFeedbackText, Mode=OneWay}"
                               Visibility="{Binding IsCopyFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                               Style="{StaticResource RedumpDetails.Feedback}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>